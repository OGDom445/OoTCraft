+                              "C:\\Program Files\\Microsoft", "C:\\Program Files\\Zulu" }) {
+        WIN32_FIND_DATAA fd;
+        HANDLE h = FindFirstFileA((std::string(root) + "\\jdk-2*").c_str(), &fd);
+        std::string best;
+        if (h != INVALID_HANDLE_VALUE) {
+            do {
+                std::string dir = std::string(root) + "\\" + fd.cFileName;
+                if (FileExists(dir + "\\bin\\java.exe") && dir > best) {
+                    best = dir; // highest version
+                }
+            } while (FindNextFileA(h, &fd));
+            FindClose(h);
+        }
+        if (!best.empty()) {
+            return best;
+        }
+    }
+    return ""; // Gradle falls back to the java on PATH
+}
+#endif
+
+void LaunchMinecraft() {
+#ifdef _WIN32
+    if (sLaunchCooldown > 0 || !CVarGetInteger(CVAR_MINECRAFT("AutoLaunch"), 1)) {
+        return;
+    }
+    sLaunchCooldown = 20 * 120; // give Minecraft two minutes to start before trying again
+    std::string dir = FindModDir();
+    if (dir.empty()) {
+        SPDLOG_ERROR("[OoTCraft] can't find the ootmc Minecraft mod folder (set Minecraft.ModDir in the config)");
+        return;
+    }
+    std::string javaHome = FindJavaHome();
+    if (!javaHome.empty()) {
+        SetEnvironmentVariableA("JAVA_HOME", javaHome.c_str());
+    }
+    std::string cmd = "cmd.exe /c \"\"" + dir + "\\gradlew.bat\" runClient --no-daemon --console=plain > \"" + dir +
+                      "\\run.log\" 2>&1\"";
+    STARTUPINFOA si{};
+    si.cb = sizeof(si);
+    PROCESS_INFORMATION pi{};
+    if (CreateProcessA(nullptr, cmd.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW, nullptr, dir.c_str(), &si,
+                       &pi)) {
+        CloseHandle(pi.hThread);
+        CloseHandle(pi.hProcess);
+        SPDLOG_INFO("[OoTCraft] launched hidden Minecraft from {}", dir);
+    } else {
+        SPDLOG_ERROR("[OoTCraft] could not launch Minecraft ({})", GetLastError());
+    }
+#endif
+}
+
+void OnGameFrame() {
+    Bridge::Layout* L = Bridge::Get();
+    if (L == nullptr) {
+        return;
+    }
+    std::atomic_ref<uint64_t>(L->header.ootHeartbeat).fetch_add(1, std::memory_order_release);
+    uint64_t beat = std::atomic_ref<uint64_t>(L->header.mcHeartbeat).load(std::memory_order_acquire);
+    if (beat != sLastMcHeartbeat) {
+        sLastMcHeartbeat = beat;
+        sFramesSinceMcBeat = 0;
+    } else if (sFramesSinceMcBeat < 100000) {
+        sFramesSinceMcBeat++;
+    }
+    Bridge::McState mc;
+    if (Bridge::SeqRead(L->mc, mc) && mc.seq != 0) {
+        sMc = mc;
+        sMcValid = true;
+    }
+    if (sLaunchCooldown > 0) {
+        sLaunchCooldown--;
+    }
+    if (sFramesSinceMcBeat > 60) {
+        LaunchMinecraft(); // first start, or Minecraft closed/crashed
+    }
+}
+
+void OnPlayerUpdateBridge() {
+    if (gPlayState == nullptr || Bridge::Get() == nullptr) {
+        return;
+    }
+    PlayState* play = gPlayState;
+    Player* p = GET_PLAYER(play);
+    Bridge::Layout* L = Bridge::Get();
+    // New scene (or reloaded play state): move Minecraft's player to Link's spawn before the puppet resumes
+    if (p != nullptr && (play->sceneNum != sLastScene || (void*)play != sLastPlay)) {
+        sLastScene = play->sceneNum;
+        sLastPlay = play;
+        memset(sSeenGen, 0, sizeof(sSeenGen)); // re-read every block section for this scene
+        if (sExportedScene != play->sceneNum) {
+            sExportedScene = play->sceneNum;
+            if (play->colCtx.colHeader != nullptr && play->colCtx.colHeader->polyList != nullptr) {
+                sGridOffsets[play->sceneNum] = ComputeGridOffset(play->colCtx.colHeader);
+                sGridYOffset = sGridOffsets[play->sceneNum];
+            }
+            ReplayCarves(play); // ground mined on earlier visits stays mined
+            ExportMesh(play);
+        }
+        auto off = sGridOffsets.find(play->sceneNum);
+        sGridYOffset = off != sGridOffsets.end() ? off->second : 0;
+        SpawnChunkActors(play);
+        RequestTeleport(p->actor.world.pos, p->actor.shape.rot.y);
+    }
+    if (sTeleportPending) {
+        sTeleportPendingFrames++;
+        if (sMcValid && sMc.sceneId == play->sceneNum) {
+            f32 dx = sMc.x - sTeleportPos.x, dy = sMc.y - sTeleportPos.y, dz = sMc.z - sTeleportPos.z;
+            if (dx * dx + dz * dz < 40.0f * 40.0f && fabsf(dy) < 60.0f) {
+                sTeleportPending = false;
+            }
+        }
+        if (sTeleportPendingFrames > 100) {
+            sTeleportPending = false; // give up waiting; Minecraft may not be running
+        }
+    }
+    if (p != nullptr) {
+        Bridge::SeqWrite(L->link, [&](Bridge::LinkState& s) {
+            s.sceneId = play->sceneNum;
+            s.roomId = (uint8_t)play->roomCtx.curRoom.num;
+            s.age = (uint8_t)gSaveContext.linkAge;
+            s.x = p->actor.world.pos.x;
+            s.y = p->actor.world.pos.y;
+            s.z = p->actor.world.pos.z;
+            s.yaw = p->actor.shape.rot.y;
+            s.pitch = p->actor.focus.rot.x;
+            s.flags = CurrentLinkFlags(play);
+            s.health = gSaveContext.health;
+            s.healthMax = gSaveContext.healthCapacity;
+            s.frame = play->gameplayFrames;
+            s.meshVersion = sMeshVersion;
+            s.teleportSeq = sTeleportSeq;
+            s.teleportX = sTeleportPos.x;
+            s.teleportY = sTeleportPos.y;
+            s.teleportZ = sTeleportPos.z;
+            s.teleportYaw = sTeleportYaw;
+            s.gridYOffset = sGridYOffset;
+        });
+    }
+    PollSections(play);
+    PollEvents(play);
+    if ((play->gameplayFrames % 3) == 0) {
+        ExportDyna(play);
+    }
+}
+
+void RegisterBridge() {
+    bool enabled = Minecraft_IsEnabled();
+    if (enabled && !Bridge::Open()) {
+        SPDLOG_ERROR("[OoTCraft] could not open bridge file");
+    }
+    COND_HOOK(OnGameFrameUpdate, enabled, OnGameFrame);
+    COND_HOOK(OnPlayerUpdate, enabled, OnPlayerUpdateBridge);
+}
+
+static RegisterShipInitFunc sInit(RegisterBridge, { CVAR_MINECRAFT_ENABLED });
+
+} // namespace
+
+bool BridgeConnected() {
+    return Bridge::Get() != nullptr && sMcValid && sFramesSinceMcBeat < 30;
+}
+
+const Bridge::McState* McPlayer() {
+    return (BridgeConnected() && (sMc.flags & Bridge::MC_IN_HYRULE)) ? &sMc : nullptr;
+}
+
+void RequestTeleport(const Vec3f& pos, s16 yaw) {
+    sTeleportPos = pos;
+    sTeleportYaw = yaw;
+    sTeleportSeq++;
+    sTeleportPending = true;
+    sTeleportPendingFrames = 0;
+}
+
+s16 GridYOffset() {
+    return sGridYOffset;
+}
+
+bool TeleportPending() {
+    return sTeleportPending;
+}
+
+void PushEvent(uint8_t type, int32_t x, int32_t y, int32_t z) {
+    Bridge::Layout* L = Bridge::Get();
+    if (L == nullptr) {
+        return;
+    }
+    Bridge::Event e{};
+    e.type = type;
+    e.x = x;
+    e.y = y;
+    e.z = z;
+    e.sceneId = gPlayState != nullptr ? gPlayState->sceneNum : -1;
+    Bridge::Push(L->ootToMc, e);
+}
+
+void PushFillEvent(int32_t x, int32_t y, int32_t z, uint16_t block) {
+    Bridge::Layout* L = Bridge::Get();
+    if (L == nullptr || gPlayState == nullptr) {
+        return;
+    }
+    Bridge::Event e{};
+    e.type = Bridge::EV_FILL;
+    e.x = x;
+    e.y = y;
+    e.z = z;
+    if (block & 0x8000) { // real Minecraft underground: block 100, depth below Hyrule's surface in radius
+        e.blockId = 100;
+        e.radius = block & 0x7FFF;
+    } else {
+        e.blockId = block;
+    }
+    e.sceneId = gPlayState->sceneNum;
+    Bridge::Push(L->ootToMc, e);
+}
+
+void ReexportSceneMesh(PlayState* play) {
+    ExportMesh(play);
+}
+
+int32_t SceneOriginBlocksX(int scene) {
+    return OriginX(scene);
+}
+
+void BridgeRequestExplosion(const Vec3f& pos, int radiusBlocks) {
+    Bridge::Layout* L = Bridge::Get();
+    if (L == nullptr || gPlayState == nullptr) {
+        return;
+    }
+    Bridge::Event e{};
+    e.type = Bridge::EV_EXPLOSION;
+    e.x = OriginX(gPlayState->sceneNum) + (int)floorf(pos.x / Bridge::UNITS_PER_BLOCK);
+    e.y = Bridge::ORIGIN_Y_BLOCKS + (int)floorf((pos.y - sGridYOffset) / Bridge::UNITS_PER_BLOCK);
+    e.z = (int)floorf(pos.z / Bridge::UNITS_PER_BLOCK);
+    e.sceneId = gPlayState->sceneNum;
+    e.radius = (uint16_t)radiusBlocks;
+    Bridge::Push(L->ootToMc, e);
+}
+
+Bridge::InputState* InputRegion() {
+    Bridge::Layout* L = Bridge::Get();
+    return L != nullptr ? &L->input : nullptr;
+}
+
+} // namespace Minecraft
diff --git a/soh/soh/Enhancements/Minecraft/MinecraftCombat.cpp b/soh/soh/Enhancements/Minecraft/MinecraftCombat.cpp
new file mode 100644
index 0000000..4ce7f90
--- /dev/null
+++ b/soh/soh/Enhancements/Minecraft/MinecraftCombat.cpp
@@ -0,0 +1,294 @@
+#include "Minecraft.h"
+#include "Bridge.h"
+
+#include <cmath>
+#include <deque>
+#include <unordered_map>
+
+#include <libultraship/libultraship.h>
+#include "soh/ActorDB.h"
+#include "soh/ShipInit.hpp"
+#include "soh/Enhancements/game-interactor/GameInteractor.h"
+#include "soh/Enhancements/game-interactor/GameInteractor_Hooks.h"
+
+extern "C" {
+#include "z64.h"
+#include "macros.h"
+#include "functions.h"
+#include "variables.h"
+extern PlayState* gPlayState;
+}
+
+// OoTCraft combat (Zelda side).
+//
+// * Every frame, nearby enemies, bosses, props (grass, pots, rocks) and NPCs are exported so Minecraft can spawn
+//   invisible stand-ins with matching hitboxes.
+// * When Minecraft hits a stand-in, the damage arrives here and a hidden "attacker" actor briefly places an
+//   attack collider on the target with the matching Zelda damage type (sword, arrow, fire, explosion). The target
+//   reacts through its own code, so weak points, immunities, stuns and death animations all behave normally.
+// * Zelda damage to Link is cancelled and sent to Minecraft instead; Minecraft's health is authoritative and Zelda's
+//   hearts mirror it.
+
+namespace Minecraft {
+
+namespace {
+
+struct PendingHit {
+    Actor* target;
+    u32 dmgFlags;
+    u8 damage;
+};
+
+typedef struct {
+    Actor actor;
+    ColliderCylinder collider;
+} McAttacker;
+
+s16 sAttackerId = -1;
+McAttacker* sAttacker = nullptr;
+std::deque<PendingHit> sHits;
+std::unordered_map<Actor*, uint32_t> sIds;
+std::unordered_map<uint32_t, Actor*> sById;
+uint32_t sNextId = 1;
+void* sIdPlay = nullptr;
+s16 sLastHealth = -1;
+bool sReportedDeath = false;
+
+ColliderCylinderInit sAttackInit = {
+    { COLTYPE_NONE, AT_ON | AT_TYPE_PLAYER, AC_NONE, OC1_NONE, OC2_TYPE_PLAYER, COLSHAPE_CYLINDER },
+    { ELEMTYPE_UNK2, { DMG_SLASH_KOKIRI, 0x00, 0x01 }, { 0x00000000, 0x00, 0x00 }, TOUCH_ON | TOUCH_SFX_NORMAL,
+      BUMP_NONE, OCELEM_NONE },
+    { 10, 10, 0, { 0, 0, 0 } },
+};
+
+bool ActorAlive(PlayState* play, Actor* target) {
+    for (int cat = 0; cat < ACTORCAT_MAX; cat++) {
+        for (Actor* a = play->actorCtx.actorLists[cat].head; a != nullptr; a = a->next) {
+            if (a == target) {
+                return a->update != nullptr;
+            }
+        }
+    }
+    return false;
+}
+
+void McAttacker_Init(Actor* thisx, PlayState* play) {
+    McAttacker* self = (McAttacker*)thisx;
+    thisx->room = -1;
+    Collider_InitCylinder(play, &self->collider);
+    Collider_SetCylinder(play, &self->collider, thisx, &sAttackInit);
+    sAttacker = self;
+}
+
+void McAttacker_Destroy(Actor* thisx, PlayState* play) {
+    McAttacker* self = (McAttacker*)thisx;
+    Collider_DestroyCylinder(play, &self->collider);
+    if (sAttacker == self) {
+        sAttacker = nullptr;
+    }
+}
+
+void McAttacker_Update(Actor* thisx, PlayState* play) {
+    McAttacker* self = (McAttacker*)thisx;
+    Player* player = GET_PLAYER(play);
+    if (player != nullptr) {
+        thisx->world.pos = player->actor.world.pos; // knockback pushes targets away from the player
+    }
+    self->collider.base.atFlags &= ~AT_HIT;
+    while (!sHits.empty()) {
+        PendingHit hit = sHits.front();
+        sHits.pop_front();
+        if (!ActorAlive(play, hit.target)) {
+            continue;
+        }
+        Actor* t = hit.target;
+        f32 radius = std::max<f32>(t->colChkInfo.cylRadius, 15.0f) + 5.0f;
+        f32 height = std::max<f32>(t->colChkInfo.cylHeight, 30.0f) + 10.0f;
+        self->collider.dim.radius = (s16)radius;
+        self->collider.dim.height = (s16)height;
+        self->collider.dim.yShift = 0;
+        self->collider.dim.pos.x = (s16)t->world.pos.x;
+        self->collider.dim.pos.y = (s16)(t->world.pos.y - 5.0f);
+        self->collider.dim.pos.z = (s16)t->world.pos.z;
+        self->collider.info.toucher.dmgFlags = hit.dmgFlags;
+        self->collider.info.toucher.damage = hit.damage;
+        CollisionCheck_SetAT(play, &play->colChkCtx, &self->collider.base);
+        break; // one hit per frame; the collision pass resolves it
+    }
+}
+
+uint32_t IdFor(Actor* a) {
+    auto it = sIds.find(a);
+    if (it != sIds.end()) {
+        return it->second;
+    }
+    uint32_t id = sNextId++;
+    sIds[a] = id;
+    sById[id] = a;
+    return id;
+}
+
+void ExportActors(PlayState* play) {
+    Bridge::Layout* L = Bridge::Get();
+    Player* player = GET_PLAYER(play);
+    if (L == nullptr || player == nullptr) {
+        return;
+    }
+    if ((void*)play != sIdPlay) {
+        sIdPlay = play;
+        sIds.clear();
+        sById.clear();
+        sHits.clear();
+    }
+    static const u8 cats[] = { ACTORCAT_ENEMY, ACTORCAT_BOSS, ACTORCAT_PROP, ACTORCAT_NPC, ACTORCAT_MISC };
+    Vec3f& pp = player->actor.world.pos;
+    const f32 range = 25.0f * Bridge::UNITS_PER_BLOCK;
+    Bridge::SeqWrite(L->actors, [&](Bridge::ActorRegion& r) {
+        uint32_t n = 0;
+        r.sceneId = play->sceneNum;
+        for (u8 cat : cats) {
+            for (Actor* a = play->actorCtx.actorLists[cat].head; a != nullptr && n < Bridge::MAX_ACTORS; a = a->next) {
+                if (a->update == nullptr || a->colChkInfo.cylRadius <= 0) {
+                    continue;
+                }
+                f32 dx = a->world.pos.x - pp.x, dy = a->world.pos.y - pp.y, dz = a->world.pos.z - pp.z;
+                if (dx * dx + dy * dy + dz * dz > range * range) {
+                    continue;
+                }
+                Bridge::ActorEntry& e = r.actors[n++];
+                e.id = IdFor(a);
+                e.actorType = a->id;
+                e.category = cat;
+                e.flags = (cat == ACTORCAT_ENEMY || cat == ACTORCAT_BOSS) ? 1 : 0;
+                e.x = a->world.pos.x;
+                e.y = a->world.pos.y;
+                e.z = a->world.pos.z;
+                e.radius = a->colChkInfo.cylRadius;
+                e.height = std::max<f32>(a->colChkInfo.cylHeight, 10.0f);
+                e.health = a->colChkInfo.health;
+                e.yaw = a->shape.rot.y;
+            }
+        }
+        r.count = n;
+    });
+}
+
+// Minecraft damage -> the closest Zelda attack. Sword strength scales with the Minecraft hit.
+void QueueHit(uint32_t id, int32_t kind, int32_t damage100) {
+    auto it = sById.find(id);
+    if (it == sById.end()) {
+        return;
+    }
+    f32 dmg = damage100 / 100.0f;
+    PendingHit hit{ it->second, DMG_SLASH_KOKIRI, 1 };
+    switch (kind) {
+        case Bridge::HIT_ARROW:
+            hit.dmgFlags = DMG_ARROW_NORMAL;
+            hit.damage = 2;
+            break;
+        case Bridge::HIT_FIRE:
+            hit.dmgFlags = DMG_ARROW_FIRE;
+            hit.damage = 2;
+            break;
+        case Bridge::HIT_EXPLOSION:
+            hit.dmgFlags = DMG_EXPLOSIVE;
+            hit.damage = 2;
+            break;
+        case Bridge::HIT_SWEEP:
+            hit.dmgFlags = dmg >= 6.0f ? DMG_SPIN_MASTER : DMG_SPIN_KOKIRI;
+            hit.damage = dmg >= 6.0f ? 2 : 1;
+            break;
+        default:
+            if (dmg >= 9.0f) {
+                hit.dmgFlags = DMG_SLASH_GIANT; // Biggoron-strength
+                hit.damage = 4;
+            } else if (dmg >= 6.0f) {
+                hit.dmgFlags = DMG_SLASH_MASTER;
+                hit.damage = 2;
+            } else if (dmg >= 2.0f) {
+                hit.dmgFlags = DMG_SLASH_KOKIRI;
+                hit.damage = 1;
+            } else {
+                hit.dmgFlags = DMG_DEKU_STICK; // bare hand / weak item
+                hit.damage = 1;
+            }
+            break;
+    }
+    sHits.push_back(hit);
+}
+
+// Minecraft health is the real one; Zelda's hearts mirror it, and Zelda's own damage/healing is forwarded
+void SyncHealth(PlayState* play) {
+    const Bridge::McState* mc = McPlayer();
+    if (mc == nullptr || mc->maxHealth <= 0.0f) {
+        sLastHealth = -1;
+        return;
+    }
+    s16 cur = gSaveContext.health;
+    if (sLastHealth >= 0 && cur != sLastHealth) {
+        if (cur < sLastHealth) {
+            PushEvent(Bridge::EV_PLAYER_HURT, sLastHealth - cur, 0, 0);
+        } else {
+            PushEvent(Bridge::EV_PLAYER_HEAL, cur - sLastHealth, 0, 0);
+        }
+    }
+    s16 cap = gSaveContext.healthCapacity;
+    s16 mirrored = (s16)lroundf(mc->health / mc->maxHealth * cap);
+    if (mc->flags & Bridge::MC_DEAD) {
+        mirrored = 0;
+    } else if (mirrored < 1) {
+        mirrored = 1;
+    }
+    if (mirrored > cap) {
+        mirrored = cap;
+    }
+    gSaveContext.health = mirrored;
+    sLastHealth = mirrored;
+}
+
+void OnPlayerUpdateCombat() {
+    PlayState* play = gPlayState;
+    if (play == nullptr || Bridge::Get() == nullptr) {
+        return;
+    }
+    if (sAttacker == nullptr && sAttackerId >= 0 && BridgeConnected()) {
+        Actor_Spawn(&play->actorCtx, play, sAttackerId, 0, 0, 0, 0, 0, 0, 0);
+    }
+    ExportActors(play);
+    if (BridgeConnected()) {
+        SyncHealth(play);
+    }
+}
+
+void RegisterCombat() {
+    COND_HOOK(OnPlayerUpdate, Minecraft_IsEnabled(), OnPlayerUpdateCombat);
+}
+
+static RegisterShipInitFunc sInit(RegisterCombat, { CVAR_MINECRAFT_ENABLED });
+
+} // namespace
+
+void HandleCombatEvent(const Bridge::Event& e) {
+    if (e.type == Bridge::EV_HIT_ACTOR) {
+        QueueHit((uint32_t)e.x, e.y, e.z);
+    }
+}
+
+void RegisterAttackerActor() {
+    static ActorDBInit init = {
+        "Mc_Attacker",
+        "Minecraft Attack Relay",
+        ACTORCAT_ITEMACTION,
+        (ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED),
+        OBJECT_GAMEPLAY_KEEP,
+        sizeof(McAttacker),
+        (ActorFunc)McAttacker_Init,
+        (ActorFunc)McAttacker_Destroy,
+        (ActorFunc)McAttacker_Update,
+        nullptr,
+        nullptr,
+    };
+    sAttackerId = ActorDB::Instance->AddEntry(init).entry.id;
+}
+
+} // namespace Minecraft
diff --git a/soh/soh/Enhancements/Minecraft/MinecraftControls.cpp b/soh/soh/Enhancements/Minecraft/MinecraftControls.cpp
