+
+// Shift the block grid vertically so the scene's floors (weighted by area) land on block boundaries.
+// OoT levels are built on round heights, so one offset usually lines up ground, ledges and platforms.
+s16 ComputeGridOffset(CollisionHeader* col) {
+    double weight[30] = {};
+    for (int i = 0; i < col->numPolygons; i++) {
+        CollisionPoly* p = &col->polyList[i];
+        if (COLPOLY_GET_NORMAL(p->normal.y) < 0.9f) {
+            continue;
+        }
+        Vec3s& a = col->vtxList[COLPOLY_VTX_INDEX(p->flags_vIA)];
+        Vec3s& b = col->vtxList[COLPOLY_VTX_INDEX(p->flags_vIB)];
+        Vec3s& c = col->vtxList[p->vIC];
+        f32 area = fabsf((b.x - a.x) * (c.z - a.z) - (c.x - a.x) * (b.z - a.z)) * 0.5f;
+        int y = (int)lroundf((a.y + b.y + c.y) / 3.0f);
+        int m = ((y % 30) + 30) % 30;
+        weight[m] += area;
+    }
+    int best = 0;
+    for (int m = 1; m < 30; m++) {
+        if (weight[m] > weight[best]) {
+            best = m;
+        }
+    }
+    return (s16)best;
+}
+
+u32 SurfaceFlags(CollisionContext* colCtx, CollisionPoly* poly, s32 bgId) {
+    u32 flags = 0;
+    if (SurfaceType_IsHookshotSurface(colCtx, poly, bgId)) {
+        flags |= 1;
+    }
+    u32 wallType = func_80041D94(colCtx, poly, bgId); // wall type: 2 ladder, 3 ladder top, 4 vines
+    if (wallType == 2 || wallType == 3 || wallType == 4) {
+        flags |= 2;
+    }
+    return flags;
+}
+
+// Scene collision mesh for Minecraft's collision field.
+// File: "OOTM" u32, version u32 (2), scene i32, triCount u32, waterCount u32,
+//       triCount * { f32 v[9], u32 flags }, waterCount * { i16 xMin, ySurface, zMin, xLength, zLength, pad }
+void ExportMesh(PlayState* play) {
+    CollisionHeader* col = play->colCtx.colHeader;
+    if (col == nullptr || col->vtxList == nullptr || col->polyList == nullptr) {
+        return;
+    }
+    std::vector<Bridge::DynaTri> tris;
+    tris.reserve(col->numPolygons);
+    for (int i = 0; i < col->numPolygons; i++) {
+        CollisionPoly* p = &col->polyList[i];
+        // Skip polys that only block the camera / are excluded for the player (or were mined away)
+        if (SurfaceType_IsIgnoredByEntities(&play->colCtx, p, BGCHECK_SCENE) ||
+            (p->flags_vIA & 0x4000) /* ignored by entities */) {
+            continue;
+        }
+        // Exit walls (cave mouths, some doorways): walk through them so Link crosses into the exit.
+        // Exit floors stay solid; Link triggers those by standing on them.
+        if (SurfaceType_GetSceneExitIndex(&play->colCtx, p, BGCHECK_SCENE) != 0) {
+            if (COLPOLY_GET_NORMAL(p->normal.y) < 0.5f) {
+                continue;
+            }
+        }
+        Vec3s& a = col->vtxList[COLPOLY_VTX_INDEX(p->flags_vIA)];
+        Vec3s& b = col->vtxList[COLPOLY_VTX_INDEX(p->flags_vIB)];
+        Vec3s& c = col->vtxList[p->vIC];
+        Bridge::DynaTri t{};
+        t.v[0] = a.x; t.v[1] = a.y; t.v[2] = a.z;
+        t.v[3] = b.x; t.v[4] = b.y; t.v[5] = b.z;
+        t.v[6] = c.x; t.v[7] = c.y; t.v[8] = c.z;
+        t.flags = SurfaceFlags(&play->colCtx, p, BGCHECK_SCENE);
+        tris.push_back(t);
+    }
+    // Dug ground: the clipped remains of the level triangles that crossed dug blocks
+    std::vector<TerrainPiece> pieces;
+    AppendTerrainPieces(pieces);
+    for (const TerrainPiece& pc : pieces) {
+        Bridge::DynaTri t{};
+        memcpy(t.v, pc.v, sizeof(t.v));
+        t.flags = SurfaceFlags(&play->colCtx, (CollisionPoly*)pc.src, BGCHECK_SCENE);
+        tris.push_back(t);
+    }
+    std::string path = std::string(Bridge::TempDirPath()) + "oot_mc_mesh_" + std::to_string(play->sceneNum) + ".bin";
+    std::string tmpPath = path + ".tmp";
+    {
+        std::ofstream out(tmpPath, std::ios::binary | std::ios::trunc);
+        uint32_t header[5] = { 0x4D544F4F, 2, (uint32_t)play->sceneNum, (uint32_t)tris.size(), col->numWaterBoxes };
+        out.write((const char*)header, sizeof(header));
+        out.write((const char*)tris.data(), tris.size() * sizeof(Bridge::DynaTri));
+        for (int i = 0; i < col->numWaterBoxes; i++) {
+            WaterBox& w = col->waterBoxes[i];
+            int16_t wb[6] = { w.xMin, w.ySurface, w.zMin, w.xLength, w.zLength, 0 };
+            out.write((const char*)wb, sizeof(wb));
+        }
+    }
+#ifdef _WIN32
+    MoveFileExA(tmpPath.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING);
+#else
+    std::rename(tmpPath.c_str(), path.c_str());
+#endif
+    sGridOffsets[play->sceneNum] = ComputeGridOffset(col);
+    sMeshVersion++;
+    SPDLOG_INFO("[OoTCraft] exported {} collision triangles, {} water boxes for scene {}", tris.size(),
+                col->numWaterBoxes, play->sceneNum);
+}
+
+// Moving collision (platforms, elevators, push blocks, doors with collision) near the player, every few frames
+void ExportDyna(PlayState* play) {
+    Bridge::Layout* L = Bridge::Get();
+    Player* player = GET_PLAYER(play);
+    if (L == nullptr || player == nullptr) {
+        return;
+    }
+    DynaCollisionContext* dyna = &play->colCtx.dyna;
+    Vec3f& pp = player->actor.world.pos;
+    const f32 range = 25.0f * Bridge::UNITS_PER_BLOCK;
+    Bridge::SeqWrite(L->dyna, [&](Bridge::DynaRegion& r) {
+        uint32_t n = 0;
+        r.sceneId = play->sceneNum;
+        for (s32 bgId = 0; bgId < BG_ACTOR_MAX && n < Bridge::DYNA_MAX_TRIS; bgId++) {
+            if (!(dyna->bgActorFlags[bgId] & 1)) { // not in use
+                continue;
+            }
+            BgActor* bg = &dyna->bgActors[bgId];
+            if (bg->actor == nullptr || bg->colHeader == nullptr || IsBlockChunkActor(bg->actor) || IsTerrainPatchActor(bg->actor)) {
+                continue; // blocks already exist in Minecraft
+            }
+            f32 dx = bg->boundingSphere.center.x - pp.x, dy = bg->boundingSphere.center.y - pp.y,
+                dz = bg->boundingSphere.center.z - pp.z;
+            f32 reach = range + bg->boundingSphere.radius;
+            if (dx * dx + dy * dy + dz * dz > reach * reach) {
+                continue;
+            }
+            s32 start = bg->dynaLookup.polyStartIndex;
+            s32 count = bg->colHeader->numPolygons;
+            for (s32 i = 0; i < count && n < Bridge::DYNA_MAX_TRIS; i++) {
+                CollisionPoly* p = &dyna->polyList[start + i];
+                Vec3s& a = dyna->vtxList[COLPOLY_VTX_INDEX(p->flags_vIA)];
+                Vec3s& b = dyna->vtxList[COLPOLY_VTX_INDEX(p->flags_vIB)];
+                Vec3s& c = dyna->vtxList[p->vIC];
+                Bridge::DynaTri& t = r.tris[n++];
+                t.v[0] = a.x; t.v[1] = a.y; t.v[2] = a.z;
+                t.v[3] = b.x; t.v[4] = b.y; t.v[5] = b.z;
+                t.v[6] = c.x; t.v[7] = c.y; t.v[8] = c.z;
+                t.flags = SurfaceFlags(&play->colCtx, p, bgId);
+            }
+        }
+        r.count = n;
+    });
+}
+
+void PollSections(PlayState* play) {
+    Bridge::Layout* L = Bridge::Get();
+    for (uint32_t i = 0; i < Bridge::SECTION_SLOTS; i++) {
+        Bridge::SectionSlot& slot = L->sections[i];
+        std::atomic_ref<uint32_t> gen(slot.gen);
+        uint32_t g1 = gen.load(std::memory_order_acquire);
+        if ((g1 & 1) || g1 == sSeenGen[i]) {
+            continue;
+        }
+        int32_t sx = slot.sx, sy = slot.sy, sz = slot.sz;
+        int16_t scene = slot.sceneId;
+        memcpy(sScratch, slot.blocks, sizeof(sScratch));
+        std::atomic_thread_fence(std::memory_order_acquire);
+        if (gen.load(std::memory_order_relaxed) != g1) {
+            continue;
+        }
+        sSeenGen[i] = g1;
+        if (scene != play->sceneNum) {
+            continue;
+        }
+        ApplySection(play, sx - OriginX(scene) / 16, sy - Bridge::ORIGIN_Y_BLOCKS / 16, sz, sScratch);
+    }
+}
+
+void PollEvents(PlayState* play) {
+    TerrainTick(play);
+    SyncZeldaItems(play);
+    Bridge::Layout* L = Bridge::Get();
+    Bridge::Event e;
+    while (Bridge::Pop(L->mcToOot, e)) {
+        switch (e.type) {
+            case Bridge::EV_PLAYER_DIED:
+                // Minecraft health is authoritative: dying there is a Game Over here
+                gSaveContext.health = 0;
+                break;
+            case Bridge::EV_HIT_ACTOR:
+                HandleCombatEvent(e);
+                break;
+            case Bridge::EV_CARVE:
+                if (e.sceneId == play->sceneNum) {
+                    CarveTerrain(play, e.x, e.y, e.z);
+                }
+                break;
+            case Bridge::EV_BLOCK_BROKEN:
+                TerrainBlockBroken(play, e.x, e.y, e.z);
+                break;
+            case Bridge::EV_BLAST:
+                TerrainBlast(play, e.x, e.y, e.z, e.radius / 10.0f);
+                break;
+            case Bridge::EV_USE_ZELDA_ITEM:
+                UseZeldaItem(play, e.x);
+                break;
+            case Bridge::EV_CELL_AIR:
+                TerrainCellAir(play, e.x, e.y, e.z);
+                break;
+            case Bridge::EV_VOID_OUT:
+                if (play->transitionTrigger == TRANS_TRIGGER_OFF && play->transitionMode == TRANS_MODE_OFF) {
+                    Play_TriggerVoidOut(play);
+                }
+                break;
+            default:
+                break;
+        }
+    }
+}
