+extern "C" s32 Minecraft_SealedFromWater(PlayState* play, f32 x, f32 z, f32 ySurface) {
+    using namespace Minecraft;
+    if (play == nullptr || !Minecraft_IsEnabled()) {
+        return false;
+    }
+    auto it = sConverted.find(play->sceneNum);
+    if (it == sConverted.end() || it->second.empty()) {
+        return false; // nothing dug here: Zelda's water is untouched
+    }
+    Player* player = GET_PLAYER(play);
+    if (player == nullptr || fabsf(x - player->actor.world.pos.x) + fabsf(z - player->actor.world.pos.z) > 90.0f) {
+        return false;
+    }
+    // Ground of the original level between Link (head height) and the water surface: he's under the ground
+    f32 hitY;
+    CollisionPoly* above = SurfaceAbove(play, x, player->actor.world.pos.y + 40.0f, z, &hitY);
+    return above != nullptr && COLPOLY_GET_NORMAL(above->normal.y) > 0 && hitY < ySurface;
+}
