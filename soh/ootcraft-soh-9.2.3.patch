@@ -0,0 +1,543 @@
+#include "Minecraft.h"
+#include "Bridge.h"
+
+#include <cmath>
+
+#include <libultraship/libultraship.h>
+#include <ship/window/Window.h>
+#include "soh/OTRGlobals.h"
+#include "soh/ShipInit.hpp"
+#include "soh/Enhancements/game-interactor/GameInteractor.h"
+#include "soh/Enhancements/game-interactor/GameInteractor_Hooks.h"
+#include "soh/Enhancements/cosmetics/cosmeticsTypes.h"
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <Windows.h>
+#endif
+
+extern "C" {
+#include "z64.h"
+#include "macros.h"
+#include "functions.h"
+#include "variables.h"
+extern PlayState* gPlayState;
+void Mouse_GetDelta(s32* x, s32* y);
+}
+
+// OoTCraft input + puppet layer (Zelda side).
+//
+// While Minecraft drives the player, the Zelda window keeps focus but its keyboard/mouse are forwarded to the
+// hidden Minecraft client as raw key events, like SkyCraft's InputBridge. Zelda's own controller input is
+// swallowed; Link becomes a puppet placed at Minecraft's player position every frame, and the view uses
+// Minecraft's camera.
+//
+// When Zelda needs input (dialogue, pause menu, ocarina, cutscenes, handoffs) the keyboard drives Zelda instead:
+//   Space / Enter / Left click = A,  Right click / Backspace = B,  Esc = Start,  WASD = stick,
+//   arrows = C buttons (ocarina notes),  Q = Z,  Shift = R.
+
+namespace Minecraft {
+
+namespace {
+
+enum class InputOwner { None, Minecraft, Zelda };
+
+InputOwner sOwner = InputOwner::None;
+bool sPrevVk[256] = {};
+bool sPrevLmb = false, sPrevRmb = false, sPrevMmb = false;
+bool sMouseCaptured = false;
+bool sPuppetActive = false;
+bool sFpActiveThisFrame = false;
+Vec3f sPuppetPos{};
+uint32_t sZeldaPrevSynth = 0;
+int32_t sMouseDxTotal = 0, sMouseDyTotal = 0, sWheelTotal = 0;
+bool sLinkMode = false; // F5 / G: Link plays himself in third person (Zelda camera and controls); Steve follows
+bool sRmbToZelda = false;
+int sPendingItemPress = 0; // frames until C-left is pressed for a Zelda item used from Minecraft // this right-click went to Zelda's A button (talk/open/check) instead of Minecraft
+
+std::shared_ptr<Ship::Window> Window() {
+    return Ship::Context::GetInstance()->GetWindow();
+}
+
+#ifdef _WIN32
+HWND GameHwnd() {
+    HWND fg = GetForegroundWindow();
+    DWORD pid = 0;
+    GetWindowThreadProcessId(fg, &pid);
+    return pid == GetCurrentProcessId() ? fg : nullptr;
+}
+#endif
+
+bool MenuOpen() {
+    auto gui = Window()->GetGui();
+    return gui != nullptr && gui->GetMenuOrMenubarVisible();
+}
+
+void SetCapture(bool capture) {
+    if (capture != sMouseCaptured || capture != Window()->IsMouseCaptured()) {
+        Window()->SetMouseCapture(capture);
+        sMouseCaptured = capture;
+    }
+}
+
+#ifdef _WIN32
+// Windows virtual key -> GLFW key code (0 = not forwarded)
+int VkToGlfw(int vk) {
+    if ((vk >= 'A' && vk <= 'Z') || (vk >= '0' && vk <= '9')) {
+        return vk;
+    }
+    if (vk >= VK_F2 && vk <= VK_F12) {
+        return 290 + (vk - VK_F1);
+    }
+    switch (vk) {
+        case VK_SPACE: return 32;
+        case VK_ESCAPE: return 256;
+        case VK_RETURN: return 257;
+        case VK_TAB: return 258;
+        case VK_BACK: return 259;
+        case VK_DELETE: return 261;
+        case VK_RIGHT: return 262;
+        case VK_LEFT: return 263;
+        case VK_DOWN: return 264;
+        case VK_UP: return 265;
+        case VK_LSHIFT: return 340;
+        case VK_LCONTROL: return 341;
+        case VK_LMENU: return 342;
+        case VK_RSHIFT: return 344;
+        case VK_RCONTROL: return 345;
+        case VK_RMENU: return 346;
+        case VK_OEM_MINUS: return 45;
+        case VK_OEM_PLUS: return 61;
+        case VK_OEM_2: return 47;
+        case VK_OEM_PERIOD: return 46;
+        case VK_OEM_COMMA: return 44;
+        case VK_OEM_1: return 59;
+        case VK_OEM_7: return 39;
+        case VK_OEM_3: return 96;
+        case VK_OEM_4: return 91;
+        case VK_OEM_6: return 93;
+        case VK_OEM_5: return 92;
+        default: return 0;
+    }
+}
+
+int CurrentMods(const bool* vk) {
+    int mods = 0;
+    if (vk[VK_LSHIFT] || vk[VK_RSHIFT]) mods |= 1;
+    if (vk[VK_LCONTROL] || vk[VK_RCONTROL]) mods |= 2;
+    if (vk[VK_LMENU] || vk[VK_RMENU]) mods |= 4;
+    return mods;
+}
+#endif
+
+bool PlayerFrozen(PlayState* play, Player* player) {
+    if (play->transitionTrigger != TRANS_TRIGGER_OFF || play->transitionMode != TRANS_MODE_OFF) {
+        return true;
+    }
+    if (play->csCtx.state != CS_STATE_IDLE || play->msgCtx.msgMode != MSGMODE_NONE || play->pauseCtx.state != 0) {
+        return true;
+    }
+    if (gSaveContext.gameMode != GAMEMODE_NORMAL) {
+        return true;
+    }
+    const u32 busy = PLAYER_STATE1_LOADING | PLAYER_STATE1_IN_CUTSCENE | PLAYER_STATE1_DEAD |
+                     PLAYER_STATE1_GETTING_ITEM | PLAYER_STATE1_IN_ITEM_CS;
+    return (player->stateFlags1 & busy) || (player->stateFlags2 & PLAYER_STATE2_OCARINA_PLAYING);
+}
+
+// The blue A button offers something to do with what's in front of Link
+bool InteractionOffered(PlayState* play) {
+    switch (play->interfaceCtx.unk_1F0) {
+        case DO_ACTION_CHECK:
+        case DO_ACTION_ENTER:
+        case DO_ACTION_OPEN:
+        case DO_ACTION_SPEAK:
+        case DO_ACTION_GRAB:
+        case DO_ACTION_DECIDE:
+        case DO_ACTION_SAVE:
+            return true;
+        default:
+            return false;
+    }
+}
+
+#ifdef _WIN32
+// Mouse totals and cursor for Minecraft
+void PublishInput() {
+    Bridge::InputState* in = InputRegion();
+    if (in == nullptr) {
+        return;
+    }
+    HWND hwnd = GameHwnd();
+    RECT rc{};
+    POINT cur{};
+    float cx = 0.5f, cy = 0.5f;
+    if (hwnd != nullptr && GetClientRect(hwnd, &rc) && GetCursorPos(&cur) && ScreenToClient(hwnd, &cur) &&
+        rc.right > 0 && rc.bottom > 0) {
+        cx = (float)cur.x / rc.right;
+        cy = (float)cur.y / rc.bottom;
+    }
+    Bridge::SeqWrite(*in, [&](Bridge::InputState& s) {
+        s.mouseDxTotal = sMouseDxTotal;
+        s.mouseDyTotal = sMouseDyTotal;
+        s.wheelTotal = sWheelTotal;
+        s.cursorX = cx;
+        s.cursorY = cy;
+        s.flags = sOwner == InputOwner::Minecraft ? 1u : 0u;
+    });
+}
+#endif
+
+bool ZeldaWantsInput(PlayState* play, Player* player) {
+    return play->msgCtx.msgMode != MSGMODE_NONE || play->pauseCtx.state != 0 ||
+           (player->stateFlags2 & PLAYER_STATE2_OCARINA_PLAYING) || play->csCtx.state != CS_STATE_IDLE ||
+           HandoffActive();
+}
+
+#ifdef _WIN32
+void ReleaseAllForwarded() {
+    for (int vk = 0; vk < 256; vk++) {
+        if (sPrevVk[vk]) {
+            int key = VkToGlfw(vk);
+            if (key != 0) {
+                PushEvent(Bridge::EV_KEY, key, 0, 0);
+            }
+        }
+    }
+    if (sPrevLmb) PushEvent(Bridge::EV_MOUSE_BUTTON, 0, 0, 0);
+    if (sPrevRmb) PushEvent(Bridge::EV_MOUSE_BUTTON, 1, 0, 0);
+    if (sPrevMmb) PushEvent(Bridge::EV_MOUSE_BUTTON, 2, 0, 0);
+}
+
+// Keyboard drives Zelda: translate to N64 buttons on top of the regular controller mapping.
+// Dialogue/menus: Space/Enter/LMB = A, RMB = B. Link mode: Space = A, LMB = B (sword), RMB = R (shield),
+// 1/2/3 = C-left/C-down/C-right items, F = C-up.
+void ApplyZeldaKeyboard(Input* input, const bool* vk, bool lmb, bool rmb, bool linkMode) {
+    u32 synth = 0, strip = 0;
+    if (vk[VK_SPACE] || (lmb && !linkMode)) {
+        synth |= BTN_A;
+    }
+    strip |= BTN_START | BTN_L; // the default keyboard map has Start on Space and L on E
+    if ((rmb && !linkMode) || vk[VK_BACK] || (lmb && linkMode)) synth |= BTN_B;
+    if (linkMode) {
+        if (rmb) synth |= BTN_R;
+        if (vk['1']) synth |= BTN_CLEFT;
+        if (vk['2']) synth |= BTN_CDOWN;
+        if (vk['3']) synth |= BTN_CRIGHT;
+        if (vk['F']) synth |= BTN_CUP;
+    }
+    if (vk[VK_RETURN]) synth |= BTN_START;
+    if (sPendingItemPress > 0 && --sPendingItemPress <= 2) {
+        synth |= BTN_CLEFT; // held for a couple of frames: the item comes out
+    }
+    if (vk['Q']) synth |= BTN_Z;
+    if (vk[VK_LSHIFT] || vk[VK_RSHIFT]) synth |= BTN_R;
+    input->cur.button = (input->cur.button & ~strip) | synth;
+    input->press.button = (input->press.button & ~strip) | (synth & ~sZeldaPrevSynth);
+    sZeldaPrevSynth = synth;
+}
+#endif
+
+void OnGameStateMainStart() {
+    PlayState* play = gPlayState;
+    if (play == nullptr || !Minecraft_IsEnabled() || play->state.running == 0) {
+        sPuppetActive = false;
+        SetCapture(false);
+        return;
+    }
+    Player* player = GET_PLAYER(play);
+    if (player == nullptr) {
+        return;
+    }
+    const Bridge::McState* mc = McPlayer();
+    Input* input = &play->state.input[0];
+
+    bool zelda = ZeldaWantsInput(play, player);
+    bool frozen = PlayerFrozen(play, player);
+    InputOwner owner = mc == nullptr ? InputOwner::None : (zelda ? InputOwner::Zelda : InputOwner::Minecraft);
+
+#ifdef _WIN32
+    if (owner != sOwner && sOwner == InputOwner::Minecraft) {
+        ReleaseAllForwarded();
+    }
+    sOwner = owner;
+
+    HWND hwnd = GameHwnd();
+    bool focus = hwnd != nullptr && !MenuOpen();
+    bool vk[256] = {};
+    if (focus) {
+        for (int i = 1; i < 256; i++) {
+            vk[i] = (GetAsyncKeyState(i) & 0x8000) != 0;
+        }
+    }
+    bool lmb = vk[VK_LBUTTON], rmb = vk[VK_RBUTTON], mmb = vk[VK_MBUTTON];
+    bool togglePressed = (vk['G'] && !sPrevVk['G']) || (vk[VK_F5] && !sPrevVk[VK_F5]);
+    if (togglePressed && mc != nullptr && !(mc->flags & Bridge::MC_SCREEN_OPEN) &&
+        play->msgCtx.msgMode == MSGMODE_NONE && play->pauseCtx.state == 0) {
+        sLinkMode = !sLinkMode;
+        player->actor.focus.rot.x = 0; // don't carry Minecraft's last look up/down into third person
+        if (sLinkMode) {
+            // Third person starts right behind Steve, facing where he was looking
+            play->manualCamera = false;
+            f32 s = Math_SinS(player->actor.shape.rot.y), c = Math_CosS(player->actor.shape.rot.y);
+            Vec3f at = { player->actor.world.pos.x, player->actor.world.pos.y + 50.0f, player->actor.world.pos.z };
+            Vec3f eye = { at.x - s * 180.0f, at.y + 30.0f, at.z - c * 180.0f };
+            Play_CameraSetAtEye(play, MAIN_CAM, &at, &eye);
+        }
+    }
+    bool mcScreen = mc != nullptr && (mc->flags & Bridge::MC_SCREEN_OPEN);
+
+    s32 mdx = 0, mdy = 0;
+    Mouse_GetDelta(&mdx, &mdy);
+    Ship::CoordsF wheel = focus ? Window()->GetMouseWheel() : Ship::CoordsF{ 0, 0 };
+
+    if (owner == InputOwner::Minecraft) {
+        play->manualCamera = false; // the mouse is Minecraft's: it mustn't swing Zelda's hidden free-look camera
+        SetCapture(focus && !mcScreen);
+        int mods = CurrentMods(vk);
+        for (int i = 8; i < 256; i++) {
+            if (i == VK_SHIFT || i == VK_CONTROL || i == VK_MENU || i == VK_F1 || i == 'G' || i == VK_F5 ||
+                (i == 'R' && !mcScreen)) {
+                // generic modifiers duplicate L/R variants; F1 opens the SoH menu; G/F5 switch to Zelda's third
+                // person; R is Zelda's A button (talk, open, check)
+                continue;
+            }
+            if (vk[i] == sPrevVk[i]) {
+                continue;
+            }
+            int key = VkToGlfw(i);
+            if ((key == 256 || key == 257) && !mcScreen) {
+                continue; // Esc is the SoH menu; Enter opens Zelda's pause menu (items, map, quest status)
+            }
+            if (key != 0) {
+                PushEvent(Bridge::EV_KEY, key, vk[i] ? 1 : 0, mods);
+            }
+        }
+        if (lmb != sPrevLmb) PushEvent(Bridge::EV_MOUSE_BUTTON, 0, lmb ? 1 : 0, mods);
+        // Right click talks/opens/checks when Zelda offers that action (blue A button), otherwise it's Minecraft's
+        if (rmb && !sPrevRmb && !mcScreen && InteractionOffered(play)) {
+            sRmbToZelda = true;
+        }
+        if (!sRmbToZelda && rmb != sPrevRmb) PushEvent(Bridge::EV_MOUSE_BUTTON, 1, rmb ? 1 : 0, mods);
+        if (!rmb) {
+            sRmbToZelda = false;
+        }
+        if (mmb != sPrevMmb) PushEvent(Bridge::EV_MOUSE_BUTTON, 2, mmb ? 1 : 0, mods);
+        sMouseDxTotal += mdx;
+        sMouseDyTotal += mdy;
+        sWheelTotal += (int32_t)wheel.y;
+
+        // Zelda sees no controller input while Minecraft drives, except Enter -> Start (pause menu) and
+        // R / right click -> A (talk, open doors and chests, check signs)
+        u32 buttons = 0, prevButtons = 0;
+        if (!mcScreen) {
+            buttons |= vk[VK_RETURN] ? BTN_START : 0;
+            prevButtons |= sPrevVk[VK_RETURN] ? BTN_START : 0;
+            buttons |= (vk['R'] || (rmb && sRmbToZelda)) ? BTN_A : 0;
+            prevButtons |= (sPrevVk['R'] || (sPrevRmb && sRmbToZelda)) ? BTN_A : 0;
+        }
+        input->cur = {};
+        input->press = {};
+        input->rel = {};
+        input->cur.button = buttons;
+        input->press.button = buttons & ~prevButtons;
+    } else if (owner == InputOwner::Zelda) {
+        // F5 third person: the mouse orbits Zelda's camera (free look), except in dialogue and menus
+        SetCapture(focus && sLinkMode && play->msgCtx.msgMode == MSGMODE_NONE && play->pauseCtx.state == 0);
+        ApplyZeldaKeyboard(input, vk, lmb, rmb, sLinkMode);
+    } else {
+        SetCapture(false);
+    }
+
+    PublishInput();
+
+    for (int i = 0; i < 256; i++) {
+        sPrevVk[i] = vk[i];
+    }
+    sPrevLmb = lmb;
+    sPrevRmb = rmb;
+    sPrevMmb = mmb;
+#endif
+
+    // Zelda had control (cutscene, dialogue, getting out of bed...) and may have moved Link: hand control back to
+    // Minecraft from where Link ended up
+    static bool sWasZeldaControlled = false;
+    bool zeldaControlled = frozen || sLinkMode;
+    if (sWasZeldaControlled && !zeldaControlled) {
+        RequestTeleport(player->actor.world.pos, player->actor.shape.rot.y);
+    }
+    sWasZeldaControlled = zeldaControlled;
+
+    // Puppet: Link stands wherever Minecraft's player is
+    sPuppetActive = mc != nullptr && !frozen && !HandoffActive() && !TeleportPending() && !(mc->flags & Bridge::MC_DEAD) &&
+                    mc->sceneId == play->sceneNum && fabsf(mc->x) < 32000.0f && fabsf(mc->z) < 32000.0f &&
+                    fabsf(mc->y) < 32000.0f;
+    if (sPuppetActive) {
+        sPuppetPos = { mc->x, mc->y, mc->z };
+        // Zelda's actor-vs-actor push (Mido, signs, rocks, bushes, enemies...) from last frame: keep Link out of
+        // them and move Steve back too, so blockers block
+        Vec3f push = player->actor.colChkInfo.displacement;
+        if (fabsf(push.x) + fabsf(push.z) > 0.05f && fabsf(push.x) + fabsf(push.z) < 60.0f) {
+            sPuppetPos.x += push.x;
+            sPuppetPos.z += push.z;
+            PushEvent(Bridge::EV_NUDGE, (int32_t)(push.x * 100.0f), 0, (int32_t)(push.z * 100.0f));
+        }
+        player->actor.colChkInfo.displacement = { 0, 0, 0 }; // already applied above
+        player->actor.world.pos = sPuppetPos;
+        player->actor.prevPos = sPuppetPos;
+        player->actor.velocity = { 0, 0, 0 };
+        player->actor.speedXZ = 0.0f;
+        player->actor.shape.rot.y = mc->yaw;
+        player->actor.world.rot.y = mc->yaw;
+        player->yaw = mc->yaw;
+        // Steve looks straight ahead: the camera (and the hidden first-person body) does the looking up and down
+        player->actor.focus.rot.x = 0;
+        // No fall damage or hard landings from Zelda: Minecraft decides falls
+        player->fallStartHeight = (s16)player->actor.world.pos.y;
+        player->fallDistance = 0;
+    }
+}
+
+// After Link's update: if Zelda moved Link far from where we put him (void-out respawn, warp, scripted move),
+// move Minecraft's player there too.
+void OnPlayerUpdate() {
+    if (!sPuppetActive || gPlayState == nullptr) {
+        return;
+    }
+    Player* player = GET_PLAYER(gPlayState);
+    f32 dx = player->actor.world.pos.x - sPuppetPos.x, dy = player->actor.world.pos.y - sPuppetPos.y,
+        dz = player->actor.world.pos.z - sPuppetPos.z;
+    if (dx * dx + dz * dz > 60.0f * 60.0f || fabsf(dy) > 120.0f) {
+        RequestTeleport(player->actor.world.pos, player->actor.shape.rot.y);
+    }
+}
+
+// Zelda's HUD stays until Minecraft's own HUD layer is drawn into the frame; undo the old prototype's hiding
+void RestoreZeldaHud() {
+    static const char* elements[] = { "HUD.HeartsCount.PosType", "HUD.MagicBar.PosType",    "HUD.BButton.PosType",
+                                      "HUD.CLeftButton.PosType", "HUD.CDownButton.PosType", "HUD.CRightButton.PosType",
+                                      "HUD.CUpButton.PosType",   "HUD.StartButton.PosType", "HUD.AButton.PosType",
+                                      "HUD.Minimap.PosType" };
+    for (const char* e : elements) {
+        std::string name = std::string(CVAR_PREFIX_COSMETIC) + "." + e;
+        if (CVarGetInteger(name.c_str(), 0) == HIDDEN) {
+            CVarClear(name.c_str());
+        }
+    }
+}
+
+void RegisterControls() {
+    bool enabled = Minecraft_IsEnabled();
+    RestoreZeldaHud();
+    COND_HOOK(OnGameStateMainStart, enabled, OnGameStateMainStart);
+    COND_HOOK(OnPlayerUpdate, enabled, OnPlayerUpdate);
+    COND_HOOK(OnPlayDrawEnd, enabled, []() {
+        if (gPlayState != nullptr) {
+            DrawHud(gPlayState);
+        }
+    });
+    if (!enabled) {
+        SetCapture(false);
+    }
+}
+
+static RegisterShipInitFunc sInit(RegisterControls, { CVAR_MINECRAFT_ENABLED });
+
+} // namespace
+
+bool OverlayWanted() {
+    const Bridge::McState* mc = McPlayer();
+    return mc != nullptr && (sOwner == InputOwner::Minecraft || (mc->flags & Bridge::MC_SCREEN_OPEN)) && !sLinkMode;
+}
+
+bool PuppetActive() {
+    return sPuppetActive;
+}
+
+bool FirstPersonActive() {
+    return sFpActiveThisFrame;
+}
+
+uint32_t CurrentLinkFlags(PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    uint32_t flags = Bridge::LINK_IN_PLAY;
+    if (player == nullptr) {
+        return flags;
+    }
+    if (PlayerFrozen(play, player)) flags |= Bridge::LINK_FROZEN;
+    if (HandoffActive()) flags |= Bridge::LINK_HANDOFF;
+    if (ZeldaWantsInput(play, player)) flags |= Bridge::LINK_ZELDA_INPUT;
+    return flags;
+}
+
+// Every rendered frame (not just Zelda's 20 game ticks a second): pass mouse motion and the cursor on to
+// Minecraft right away, so looking around and the inventory cursor are as smooth as the frame rate
+void PumpInputAtFrameRate() {
+#ifdef _WIN32
+    if (sOwner != InputOwner::Minecraft) {
+        return;
+    }
+    if (sMouseCaptured) {
+        Ship::Coords d = Window()->GetMouseDelta();
+        sMouseDxTotal += d.x;
+        sMouseDyTotal += d.y;
+    }
+    PublishInput();
+#endif
+}
+
+// Steve used the Minecraft version of a Zelda item: Link takes over (third person) and uses it from C-left
+void RequestItemHandoff(PlayState* play, int slot, int item) {
+    gSaveContext.equips.buttonItems[1] = item;
+    gSaveContext.equips.cButtonSlots[0] = slot;
+    Interface_LoadItemIcon1(play, 1);
+    if (!sLinkMode) {
+        sLinkMode = true;
+        GET_PLAYER(play)->actor.focus.rot.x = 0;
+    }
+    sPendingItemPress = 5;
+}
+
+bool HandoffActive() {
+    return sLinkMode && McPlayer() != nullptr;
+}
+
+} // namespace Minecraft
+
+extern "C" s32 Minecraft_IsEnabled(void) {
+    return CVarGetInteger(CVAR_MINECRAFT_ENABLED, 1);
+}
+
+// Zelda renders from Minecraft's camera while Minecraft drives the player
+extern "C" s32 Minecraft_OverrideView(void* cameraPtr, Vec3f* eye, Vec3f* at, f32* fov) {
+    using namespace Minecraft;
+    Camera* camera = (Camera*)cameraPtr;
+    PlayState* play = camera->play;
+    if (camera != play->cameraPtrs[MAIN_CAM]) {
+        return false;
+    }
+    sFpActiveThisFrame = false;
+    if (play->activeCamera != MAIN_CAM || !sPuppetActive) {
+        return false;
+    }
+    const Bridge::McState* mc = McPlayer();
+    if (mc == nullptr || (mc->flags & Bridge::MC_THIRD_PERSON)) {
+        return false;
+    }
+    // Pre-rendered rooms (houses, shops, Castle Town) are a painted background with a fixed camera
+    if (play->roomCtx.curRoom.meshHeader != nullptr && play->roomCtx.curRoom.meshHeader->base.type == 1) {
+        return false;
+    }
+    f32 cp = Math_CosS(mc->pitch);
+    Vec3f d = { Math_SinS(mc->yaw) * cp, Math_SinS(mc->pitch), Math_CosS(mc->yaw) * cp };
+    eye->x = mc->x;
+    eye->y = mc->y + mc->eyeHeight;
+    eye->z = mc->z;
+    at->x = eye->x + d.x * 100.0f;
+    at->y = eye->y + d.y * 100.0f;
+    at->z = eye->z + d.z * 100.0f;
+    *fov = mc->fov;
+    sFpActiveThisFrame = true;
+    return true;
+}
