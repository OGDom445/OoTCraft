+void FillRect(Gfx** gfx, int x0, int y0, int x1, int y1, u8 r, u8 g, u8 b, u8 a) {
+    Gfx* g2 = *gfx;
+    gDPPipeSync(g2++);
+    gDPSetCombineMode(g2++, G_CC_PRIMITIVE, G_CC_PRIMITIVE);
+    gDPSetPrimColor(g2++, 0, 0, r, g, b, a);
+    gDPFillRectangle(g2++, x0, y0, x1, y1);
+    *gfx = g2;
+}
