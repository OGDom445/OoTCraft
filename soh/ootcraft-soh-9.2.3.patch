diff --git a/soh/soh/Enhancements/Minecraft/Bridge.h b/soh/soh/Enhancements/Minecraft/Bridge.h
new file mode 100644
index 0000000..8cb89ed
--- /dev/null
+++ b/soh/soh/Enhancements/Minecraft/Bridge.h
@@ -0,0 +1,277 @@
+#pragma once
+
+// OoTCraft shared-memory bridge between Ship of Harkinian and the hidden Minecraft client ("ootmc" Fabric mod).
+// Both processes map %TEMP%/oot_mc_bridge.bin. The layout must match Bridge.java exactly (little-endian).
+//
+// Authority (same split as SkyCraft):
+//   Minecraft  -> the player: position, physics, camera, inventory, health, blocks
+//   Zelda      -> the world: terrain, enemies, NPCs, cutscenes, dialogue, scene changes, progress
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace Bridge {
+
+constexpr uint32_t MAGIC = 0x4D544F4F; // "OOTM"
+constexpr uint32_t VERSION = 3;
+constexpr uint32_t RING_CAP = 4096; // power of two
+constexpr uint32_t SECTION_SLOTS = 512;
+constexpr uint32_t SECTION_VOLUME = 16 * 16 * 16;
+constexpr uint32_t DYNA_MAX_TRIS = 4096;
+constexpr uint32_t MAX_ACTORS = 64;
+
+// Each OoT scene is laid out in its own region of the Minecraft "ootmc:hyrule" dimension.
+constexpr int32_t SCENE_SPACING_BLOCKS = 2048;
+constexpr int32_t ORIGIN_Y_BLOCKS = 128;
+constexpr float UNITS_PER_BLOCK = 30.0f;
+
+enum EventType : uint8_t {
+    EV_NONE = 0,
+    // Zelda -> Minecraft
+    EV_PLACE_REQUEST = 1,
+    EV_BREAK_REQUEST = 2,
+    EV_EXPLOSION = 3,
+    EV_KEY = 10,          // x = GLFW key, y = 1 press / 0 release / 2 repeat, z = GLFW mods
+    EV_MOUSE_BUTTON = 11, // x = GLFW button, y = 1 press / 0 release
+    EV_CHAR = 12,         // x = UTF-32 code point
+    EV_GIVE_ITEM = 20,    // x = OoT item id (key item obtained in Zelda)
+    EV_PLAYER_HURT = 21,  // x = damage in OoT health units (16 = one heart)
+    EV_PLAYER_HEAL = 22,  // x = health restored in OoT health units
+    EV_NUDGE = 23,        // x, y, z = Zelda pushed Link by this much (OoT units * 100): an NPC or object is in the way
+    EV_FILL = 4,          // x, y, z = block; blockId = TerrainMaterial: Hyrule terrain turned into a real block
+    // Minecraft -> Zelda
+    EV_PLAYER_DIED = 40,
+    EV_HIT_ACTOR = 41, // x = actor id, y = HitKind, z = Minecraft damage * 100
+    EV_CARVE = 42,     // x, y, z = Minecraft block: the player is mining Hyrule's own ground there
+    EV_BLOCK_BROKEN = 43, // x, y, z = Minecraft block that was mined away (dug ground spreads to its neighbours)
+    EV_BLAST = 44,        // x, y, z = explosion centre (Minecraft block), radius = blocks * 10
+    EV_USE_ZELDA_ITEM = 45, // x = OoT item id: Steve used the Minecraft version of a Zelda item
+    EV_VOID_OUT = 46,       // Steve fell out of the world: respawn at the entrance, like falling into a pit
+    EV_CELL_AIR = 47,       // x, y, z = a dug block turned out to be open air underground (cave, mineshaft...)
+};
+
+enum HitKind : int32_t {
+    HIT_MELEE = 0,
+    HIT_ARROW = 1,
+    HIT_FIRE = 2,
+    HIT_EXPLOSION = 3,
+    HIT_SWEEP = 4,
+};
+
+// LinkState.flags
+enum : uint32_t {
+    LINK_FROZEN = 1 << 0,     // cutscene / transition / pause: Minecraft must not move the player
+    LINK_HANDOFF = 1 << 1,    // Link is acting on his own (door, chest, ocarina...): Minecraft follows Link
+    LINK_ZELDA_INPUT = 1 << 2, // keyboard currently belongs to Zelda (dialogue, pause menu, ocarina)
+    LINK_IN_PLAY = 1 << 3,    // a gameplay scene is loaded
+};
+
+// McState.flags
+enum : uint32_t {
+    MC_IN_HYRULE = 1 << 0,
+    MC_SCREEN_OPEN = 1 << 1, // inventory / crafting etc: cursor belongs to Minecraft
+    MC_ON_GROUND = 1 << 2,
+    MC_SWIMMING = 1 << 3,
+    MC_SNEAKING = 1 << 4,
+    MC_DEAD = 1 << 5,
+    MC_THIRD_PERSON = 1 << 6,
+};
+
+struct alignas(64) Header {
+    uint32_t magic, version, totalSize, layoutHash;
+    uint64_t ootHeartbeat; // incremented every OoT frame
+    uint64_t mcHeartbeat;  // incremented every Minecraft frame
+    uint32_t ootPid, mcPid;
+    uint8_t _pad[24];
+};
+
+struct alignas(64) LinkState { // written by Zelda
+    uint32_t seq;
+    int16_t sceneId;
+    uint8_t roomId;
+    uint8_t age; // 0 adult, 1 child
+    float x, y, z; // Link's position (OoT units)
+    int16_t yaw, pitch;
+    uint32_t flags;
+    int16_t health, healthMax;
+    uint32_t frame;
+    uint32_t meshVersion; // bumped whenever a scene collision mesh file is written
+    uint32_t teleportSeq; // bumped when Zelda relocates the player (scene spawn, void-out, end of a handoff)
+    float teleportX, teleportY, teleportZ;
+    int16_t teleportYaw;
+    int16_t gridYOffset; // OoT units: block grid is shifted so this scene's main floors sit on block boundaries
+    uint8_t _pad[4];
+};
+
+struct alignas(64) McState { // written by Minecraft
+    uint32_t seq;
+    float x, y, z;   // player feet, OoT units
+    float eyeHeight; // OoT units
+    float fov;       // vertical degrees
+    int16_t yaw, pitch; // OoT binary angles; pitch > 0 looks up
+    uint32_t flags;
+    float health, maxHealth;
+    uint32_t frame;
+    int16_t sceneId;
+    uint8_t selectedSlot;
+    int8_t destroyStage;                  // block being mined: crack stage 0-9, -1 none
+    int32_t destroyX, destroyY, destroyZ; // that block (Minecraft coordinates)
+    uint8_t _pad[4];
+};
+
+struct alignas(64) InputState { // written by Zelda; counters only grow so Minecraft can diff them
+    uint32_t seq;
+    int32_t mouseDxTotal, mouseDyTotal;
+    int32_t wheelTotal;
+    float cursorX, cursorY; // 0..1 inside the Zelda window
+    uint32_t flags;         // bit0: Minecraft currently owns input
+    uint8_t _pad[36];
+};
+
+struct Event {
+    uint8_t type;
+    uint8_t face;
+    uint16_t blockId;
+    int32_t x, y, z;
+    int16_t sceneId;
+    uint16_t radius;
+    uint32_t frame;
+    uint8_t _pad[8];
+};
+
+struct alignas(64) Ring {
+    uint32_t head;
+    uint8_t _p0[60];
+    uint32_t tail;
+    uint8_t _p1[60];
+    Event ev[RING_CAP];
+};
+
+struct alignas(64) SectionSlot {
+    uint32_t gen; // odd while being written
+    int32_t sx, sy, sz;
+    int16_t sceneId;
+    uint16_t nonAir;
+    uint8_t _pad[44];
+    uint16_t blocks[SECTION_VOLUME]; // index = (y*16 + z)*16 + x
+};
+
+struct DynaTri {
+    float v[9];     // OoT units
+    uint32_t flags; // bit0 hookshot surface, bit1 climbable
+};
+
+struct alignas(64) DynaRegion { // moving collision near the player (platforms, doors, blocks), written by Zelda
+    uint32_t seq;
+    uint32_t count;
+    int16_t sceneId;
+    uint8_t _pad[54];
+    DynaTri tris[DYNA_MAX_TRIS];
+};
+
+struct ActorEntry {
+    uint32_t id;
+    int16_t actorType;
+    uint8_t category;
+    uint8_t flags; // bit0 hostile
+    float x, y, z;
+    float radius, height;
+    int16_t health;
+    int16_t yaw;
+    uint8_t _pad[8];
+};
+
+struct alignas(64) ActorRegion { // Zelda actors near the player that Minecraft can hit (stand-in entities)
+    uint32_t seq;
+    uint32_t count;
+    int16_t sceneId;
+    uint8_t _pad[54];
+    ActorEntry actors[MAX_ACTORS];
+};
+
+struct Layout {
+    Header header;
+    LinkState link;
+    McState mc;
+    InputState input;
+    Ring ootToMc;
+    Ring mcToOot;
+    SectionSlot sections[SECTION_SLOTS];
+    DynaRegion dyna;
+    ActorRegion actors;
+};
+
+static_assert(sizeof(Header) == 64, "layout");
+static_assert(sizeof(LinkState) == 64, "layout");
+static_assert(sizeof(McState) == 64, "layout");
+static_assert(sizeof(InputState) == 64, "layout");
+static_assert(sizeof(Event) == 32, "layout");
+static_assert(offsetof(Layout, ootToMc) == 256, "layout");
+static_assert(sizeof(Ring) == 128 + 32 * RING_CAP, "layout");
+static_assert(sizeof(SectionSlot) == 64 + 2 * SECTION_VOLUME, "layout");
+static_assert(offsetof(Layout, sections) == 256 + 2 * (128 + 32 * RING_CAP), "layout");
+static_assert(sizeof(DynaTri) == 40, "layout");
+static_assert(sizeof(DynaRegion) == 64 + 40 * DYNA_MAX_TRIS, "layout");
+static_assert(sizeof(ActorEntry) == 40, "layout");
+static_assert(sizeof(ActorRegion) == 64 + 40 * MAX_ACTORS, "layout");
+
+bool Open();
+void Close();
+Layout* Get();
+const char* TempDirPath();
+
+template <typename T, typename F> void SeqWrite(T& obj, F&& write) {
+    std::atomic_ref<uint32_t> seq(obj.seq);
+    seq.fetch_add(1, std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_release);
+    write(obj);
+    seq.fetch_add(1, std::memory_order_release);
+}
+
+template <typename T> bool SeqRead(T& shared, T& out) {
+    std::atomic_ref<uint32_t> seq(shared.seq);
+    for (int tries = 0; tries < 8; tries++) {
+        uint32_t s1 = seq.load(std::memory_order_acquire);
+        if (s1 & 1) {
+            continue;
+        }
+        out = shared;
+        std::atomic_thread_fence(std::memory_order_acquire);
+        if (seq.load(std::memory_order_relaxed) == s1) {
+            return true;
+        }
+    }
+    return false;
+}
+
+inline bool Push(Ring& r, const Event& e) {
+    std::atomic_ref<uint32_t> head(r.head), tail(r.tail);
+    uint32_t h = head.load(std::memory_order_relaxed);
+    if (h - tail.load(std::memory_order_acquire) >= RING_CAP) {
+        return false;
+    }
+    r.ev[h & (RING_CAP - 1)] = e;
+    head.store(h + 1, std::memory_order_release);
+    return true;
+}
+
+inline bool Pop(Ring& r, Event& out) {
+    std::atomic_ref<uint32_t> head(r.head), tail(r.tail);
+    uint32_t t = tail.load(std::memory_order_relaxed);
+    if (t == head.load(std::memory_order_acquire)) {
+        return false;
+    }
+    out = r.ev[t & (RING_CAP - 1)];
+    tail.store(t + 1, std::memory_order_release);
+    return true;
+}
+
+} // namespace Bridge
+
+namespace Minecraft {
+// Latest Minecraft player state, or null when Minecraft isn't connected / not in Hyrule
+const Bridge::McState* McPlayer();
+Bridge::InputState* InputRegion();
+void HandleCombatEvent(const Bridge::Event& e);
+} // namespace Minecraft
