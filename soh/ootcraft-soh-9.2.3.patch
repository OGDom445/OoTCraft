+
+const char* TempDirPath() {
+    if (sTempDir.empty()) {
+#ifdef _WIN32
+        char tmp[MAX_PATH];
+        GetTempPathA(MAX_PATH, tmp);
+        sTempDir = tmp;
+#else
+        sTempDir = "/tmp/";
+#endif
+    }
+    return sTempDir.c_str();
+}
+
+bool Open() {
+    if (sView != nullptr) {
+        return true;
+    }
+#ifdef _WIN32
+    std::string path = std::string(TempDirPath()) + "oot_mc_bridge.bin";
+    sFile = CreateFileA(path.c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                        OPEN_ALWAYS, FILE_ATTRIBUTE_TEMPORARY, nullptr);
+    if (sFile == INVALID_HANDLE_VALUE) {
+        return false;
+    }
+    sMap = CreateFileMappingA(sFile, nullptr, PAGE_READWRITE, 0, (DWORD)sizeof(Layout), nullptr);
+    if (sMap == nullptr) {
+        Close();
+        return false;
+    }
+    sView = (Layout*)MapViewOfFile(sMap, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(Layout));
+    if (sView == nullptr) {
+        Close();
+        return false;
+    }
+    if (sView->header.magic != MAGIC || sView->header.version != VERSION ||
+        sView->header.totalSize != sizeof(Layout)) {
+        memset(sView, 0, sizeof(Layout));
+        sView->header.version = VERSION;
+        sView->header.totalSize = sizeof(Layout);
+        std::atomic_ref<uint32_t>(sView->header.magic).store(MAGIC, std::memory_order_release);
+    }
+    sView->header.ootPid = GetCurrentProcessId();
+    return true;
+#else
+    return false;
+#endif
+}
+
+void Close() {
+#ifdef _WIN32
+    if (sView != nullptr) {
+        UnmapViewOfFile(sView);
+    }
+    if (sMap != nullptr) {
+        CloseHandle(sMap);
+    }
+    if (sFile != INVALID_HANDLE_VALUE) {
+        CloseHandle(sFile);
+    }
+    sMap = nullptr;
+    sFile = INVALID_HANDLE_VALUE;
+#endif
+    sView = nullptr;
