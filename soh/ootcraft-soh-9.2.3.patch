+
+bool HudOverlayActive();
+
+void DrawHud(PlayState* play) {
+    if (!FirstPersonActive() || HudOverlayActive()) {
+        return;
+    }
+    GraphicsContext* __gfxCtx = play->state.gfxCtx; // (OPEN_DISPS without frame-interpolation child records)
+    Gfx_SetupDL_39Overlay(play->state.gfxCtx);
+    Gfx* g = OVERLAY_DISP;
+    FillRect(&g, 155, 119, 166, 121, 0, 0, 0, 120);
+    FillRect(&g, 159, 115, 161, 126, 0, 0, 0, 120);
+    FillRect(&g, 156, 119, 165, 120, 255, 255, 255, 220);
+    FillRect(&g, 160, 116, 161, 125, 255, 255, 255, 220);
+    OVERLAY_DISP = g;
+}
+
+
+} // namespace Minecraft
diff --git a/soh/soh/Enhancements/Minecraft/MinecraftItems.cpp b/soh/soh/Enhancements/Minecraft/MinecraftItems.cpp
new file mode 100644
index 0000000..1165243
--- /dev/null
+++ b/soh/soh/Enhancements/Minecraft/MinecraftItems.cpp
@@ -0,0 +1,65 @@
+#include "Minecraft.h"
+#include "Bridge.h"
+
+#include <libultraship/libultraship.h>
+
+extern "C" {
+#include "z64.h"
+#include "macros.h"
+#include "functions.h"
+#include "variables.h"
+extern PlayState* gPlayState;
+}
+
+// Link's items in Minecraft. Every couple of seconds Zelda tells Minecraft which items Link owns, and Minecraft
+// keeps a matching item in Steve's inventory. Using one of those comes back here: bombs come out as real Zelda
+// bombs at Steve's feet, the rest are handed to Link (third person, item on C-left, pressed for you).
+
+namespace Minecraft {
+
+void SyncZeldaItems(PlayState* play) {
+    static u32 sLastSync = 0;
+    if (play == nullptr || play->gameplayFrames - sLastSync < 40 || !BridgeConnected()) {
+        return;
+    }
+    sLastSync = play->gameplayFrames;
+    for (int slot = 0; slot < 24; slot++) {
+        u8 item = gSaveContext.inventory.items[slot];
+        if (item != ITEM_NONE && item < ITEM_SOLD_OUT + 12) {
+            PushEvent(Bridge::EV_GIVE_ITEM, item, 0, 0);
+        }
+    }
+}
+
+void UseZeldaItem(PlayState* play, int item) {
+    if (play == nullptr || item < 0 || item >= ITEM_NONE) {
+        return;
+    }
+    Player* player = GET_PLAYER(play);
+    if (item == ITEM_BOMB) {
+        if (AMMO(ITEM_BOMB) <= 0) {
+            Sfx_PlaySfxCentered(NA_SE_SY_ERROR);
+            return;
+        }
+        // A lit bomb a step in front of Steve
+        f32 s = Math_SinS(player->actor.shape.rot.y), c = Math_CosS(player->actor.shape.rot.y);
+        Actor* bomb = Actor_Spawn(&play->actorCtx, play, ACTOR_EN_BOM, player->actor.world.pos.x + s * 35.0f,
+                                  player->actor.world.pos.y + 20.0f, player->actor.world.pos.z + c * 35.0f, 0, 0, 0,
+                                  0 /* BOMB_BODY */);
+        if (bomb != nullptr) {
+            bomb->velocity.y = 4.0f;
+            bomb->speedXZ = 3.0f;
+            bomb->world.rot.y = player->actor.shape.rot.y;
+            Inventory_ChangeAmmo(ITEM_BOMB, -1);
+        }
+        return;
+    }
+    for (int slot = 0; slot < 24; slot++) {
+        if (gSaveContext.inventory.items[slot] == item) {
+            RequestItemHandoff(play, slot, item);
+            return;
+        }
+    }
+}
+
+} // namespace Minecraft
diff --git a/soh/soh/Enhancements/Minecraft/MinecraftOverlay.cpp b/soh/soh/Enhancements/Minecraft/MinecraftOverlay.cpp
new file mode 100644
index 0000000..c27c4ff
--- /dev/null
+++ b/soh/soh/Enhancements/Minecraft/MinecraftOverlay.cpp
@@ -0,0 +1,267 @@
+﻿#include "Minecraft.h"
+#include "Bridge.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <libultraship/libultraship.h>
+#include <ship/window/gui/GuiWindow.h>
+#include <fast/Fast3dWindow.h>
+#include <fast/interpreter.h>
+#include <fast/backends/gfx_rendering_api.h>
+#include "soh/ShipInit.hpp"
+#include "soh/Enhancements/game-interactor/GameInteractor.h"
+#include "soh/Enhancements/game-interactor/GameInteractor_Hooks.h"
+#include "soh/Enhancements/cosmetics/cosmeticsTypes.h"
+
+extern "C" {
+#include "z64.h"
+#include "variables.h"
+extern PlayState* gPlayState;
+}
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <Windows.h>
+#endif
+
+// Minecraft's first-person hand and HUD (hotbar, hearts, crosshair, inventory, chat), rendered by the hidden
+// Minecraft client and shared through %TEMP%/oot_mc_frame.bin, drawn over Zelda's game view every frame.
+
+namespace Minecraft {
+
+namespace {
+
+constexpr int kMaxW = 1920, kMaxH = 1080, kHeader = 64;
+
+#ifdef _WIN32
+HANDLE sFile = INVALID_HANDLE_VALUE, sMap = nullptr;
+#endif
+uint8_t* sView = nullptr;
+uint32_t sLastSeq = 0;
+std::vector<uint8_t> sPixels;
+int sTexW = 0, sTexH = 0;
+uint32_t sTextureId = 0;
+bool sTextureValid = false;
+bool sHudHidden = false;
+
+bool OpenFrame() {
+    if (sView != nullptr) {
+        return true;
+    }
+#ifdef _WIN32
+    std::string path = std::string(Bridge::TempDirPath()) + "oot_mc_frame.bin";
+    sFile = CreateFileA(path.c_str(), GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+                        OPEN_ALWAYS, FILE_ATTRIBUTE_TEMPORARY, nullptr);
+    if (sFile == INVALID_HANDLE_VALUE) {
+        return false;
+    }
+    const DWORD size = kHeader + kMaxW * kMaxH * 4;
+    sMap = CreateFileMappingA(sFile, nullptr, PAGE_READWRITE, 0, size, nullptr);
+    if (sMap == nullptr) {
+        return false;
+    }
+    sView = (uint8_t*)MapViewOfFile(sMap, FILE_MAP_ALL_ACCESS, 0, 0, size);
+#endif
+    return sView != nullptr;
+}
+
+uint32_t& Field(int offset) {
+    return *(uint32_t*)(sView + offset);
+}
+
+// Copy the newest complete frame out of shared memory (seqlock), returns true if a new one arrived
+bool FetchFrame() {
+    std::atomic_ref<uint32_t> seq(Field(0));
+    uint32_t s1 = seq.load(std::memory_order_acquire);
+    if ((s1 & 1) || s1 == sLastSeq || s1 == 0) {
+        return false;
+    }
+    int w = (int)Field(4), h = (int)Field(8);
+    if (w <= 0 || h <= 0 || w > kMaxW || h > kMaxH) {
+        return false;
+    }
+    sPixels.resize((size_t)w * h * 4);
+    memcpy(sPixels.data(), sView + kHeader, sPixels.size());
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (seq.load(std::memory_order_relaxed) != s1) {
+        return false; // torn: try next frame
+    }
+    sLastSeq = s1;
+    sTexW = w;
+    sTexH = h;
+    return true;
+}
+
+Fast::GfxRenderingAPI* RenderingApi() {
+    auto window = std::dynamic_pointer_cast<Fast::Fast3dWindow>(Ship::Context::GetInstance()->GetWindow());
+    if (window == nullptr) {
+        return nullptr;
+    }
+    auto interpreter = window->GetInterpreterWeak().lock();
+    return interpreter ? interpreter->GetCurrentRenderingAPI() : nullptr;
+}
+
+void SetZeldaHudHidden(bool hide) {
+    if (hide == sHudHidden) {
+        return;
+    }
+    sHudHidden = hide;
+    // Minecraft's hotbar and hearts replace these; rupees, keys and the A-button prompt stay. The minimap sits where
+    // Minecraft's hand is drawn, so it only shows in Zelda's third person (F5) and on the pause screen
+    static const char* elements[] = { "HUD.HeartsCount.PosType", "HUD.MagicBar.PosType",    "HUD.BButton.PosType",
+                                      "HUD.CLeftButton.PosType", "HUD.CDownButton.PosType", "HUD.CRightButton.PosType",
+                                      "HUD.CUpButton.PosType",   "HUD.Minimap.PosType" };
+    for (const char* e : elements) {
+        std::string name = std::string(CVAR_PREFIX_COSMETIC) + "." + e;
+        if (hide) {
+            CVarSetInteger(name.c_str(), HIDDEN);
+        } else {
+            CVarClear(name.c_str());
+        }
+    }
+}
+
+// The A button only shows while it has something to say ("Open", "Talk", "Check"...); an empty blue disc
+// floating over Minecraft's HUD looks broken
+void UpdateAButton(bool overlay) {
+    static bool sAHidden = false;
+    bool hide = overlay && gPlayState != nullptr && gPlayState->interfaceCtx.unk_1F0 == DO_ACTION_NONE;
+    if (hide == sAHidden) {
+        return;
+    }
+    sAHidden = hide;
+    std::string name = std::string(CVAR_PREFIX_COSMETIC) + ".HUD.AButton.PosType";
+    if (hide) {
+        CVarSetInteger(name.c_str(), HIDDEN);
+    } else {
+        CVarClear(name.c_str());
+    }
+}
+
+class OverlayWindow : public Ship::GuiWindow {
+  public:
+    using GuiWindow::GuiWindow;
+
+    void Draw() override {
+        DrawElement();
+    }
+
+    void DrawElement() override {
+        // Frame rate log (every 10 s) to keep an eye on performance
+        static uint32_t sFrames = 0, sHitches = 0;
+        static uint64_t sFpsStart = 0, sLastFrame = 0, sWorst = 0;
+        uint64_t now = (uint64_t)std::chrono::duration_cast<std::chrono::milliseconds>(
+                           std::chrono::steady_clock::now().time_since_epoch())
+                           .count();
+        sFrames++;
+        if (sLastFrame != 0) {
+            uint64_t dt = now - sLastFrame;
+            sWorst = std::max(sWorst, dt);
+            sHitches += dt > 25 ? 1 : 0;
+        }
+        sLastFrame = now;
+        if (sFpsStart == 0) {
+            sFpsStart = now;
+        } else if (now - sFpsStart >= 10000) {
+            SPDLOG_INFO("[OoTCraft] Zelda drawing {:.0f} FPS, slowest frame {} ms, {} frames over 25 ms",
+                        sFrames * 1000.0 / (now - sFpsStart), sWorst, sHitches);
+            sFrames = 0;
+            sHitches = 0;
+            sWorst = 0;
+            sFpsStart = now;
+        }
+        PumpInputAtFrameRate();
+        bool want = OverlayWanted();
+        SetZeldaHudHidden(want);
+        UpdateAButton(want);
+        if (!OpenFrame()) {
+            return;
+        }
+        ImGuiWindow* game = ImGui::FindWindowByName("Main Game");
+        if (game != nullptr && game->Size.x > 0 && game->Size.y > 0) {
+            // Same aspect as the game view, capped at 1280x720 to keep the per-frame copy cheap
+            float scale = std::min(1.0f, std::min(1280.0f / game->Size.x, 720.0f / game->Size.y));
+            Field(16) = (uint32_t)(game->Size.x * scale);
+            Field(20) = (uint32_t)(game->Size.y * scale);
+        }
+        Field(28) = want ? 1u : 0u; // Minecraft skips the readback while nothing is shown
+        if (!want || Field(24) == 0 || game == nullptr) {
+            return;
+        }
+        Fast::GfxRenderingAPI* api = RenderingApi();
+        if (api == nullptr) {
+            return;
+        }
+        if (FetchFrame()) {
+            if (sTextureId == 0) {
+                sTextureId = api->NewTexture();
+            }
+            api->SelectTexture(0, sTextureId);
+            api->SetSamplerParameters(0, true, G_TX_CLAMP, G_TX_CLAMP);
+            api->UploadTexture(sPixels.data(), sTexW, sTexH);
+            sTextureValid = true;
+        }
+        if (!sTextureValid) {
+            return;
+        }
+        // Cover the game view; with the menu bar hidden that is the whole main viewport (this also stays correct
+        // under Windows display scaling, where the game window's own size can disagree with the screen)
+        ImGuiViewport* vp = ImGui::GetMainViewport();
+        ImVec2 min = vp->WorkPos;
+        ImVec2 max = ImVec2(vp->WorkPos.x + vp->WorkSize.x, vp->WorkPos.y + vp->WorkSize.y);
+        ImGui::GetForegroundDrawList(vp)->AddImage(api->GetTextureById(sTextureId), min, max);
+    }
+
+  protected:
+    void InitElement() override {
+    }
+    void UpdateElement() override {
+    }
+};
+
+std::shared_ptr<OverlayWindow> sOverlay;
+
+void RegisterOverlay() {
+    COND_HOOK(OnGameFrameUpdate, Minecraft_IsEnabled(), []() {
+        if (sOverlay == nullptr) {
+            auto gui = Ship::Context::GetInstance()->GetWindow()->GetGui();
+            if (gui != nullptr) {
+                sOverlay = std::make_shared<OverlayWindow>(CVAR_WINDOW("OoTCraftOverlay"), true, "OoTCraft Overlay");
+                gui->AddGuiWindow(sOverlay);
+                // Mouse look at Zelda's native 20 FPS feels laggy: draw interpolated frames at the monitor's
+                // refresh rate (applied once; it can be changed back in Settings > Graphics)
+                // A steady 60 FPS: the same rate as Minecraft's layer, and it divides evenly into 120/144/240 Hz
+                if (CVarGetInteger(CVAR_MINECRAFT("PerfDefaultsApplied"), 0) < 3) {
+                    CVarSetInteger(CVAR_SETTING("MatchRefreshRate"), 0);
+                    CVarSetInteger(CVAR_SETTING("InterpolationFPS"), 60);
+                    CVarSetInteger(CVAR_MINECRAFT("PerfDefaultsApplied"), 3);
+                    gui->SaveConsoleVariablesNextFrame();
+                }
+                // F5 third person is Zelda's camera: let the mouse orbit it
+                if (!CVarGetInteger(CVAR_MINECRAFT("ThirdPersonMouseApplied"), 0)) {
+                    CVarSetInteger(CVAR_SETTING("EnableMouse"), 1);
+                    CVarSetInteger(CVAR_SETTING("FreeLook.Enabled"), 1);
+                    CVarSetInteger(CVAR_MINECRAFT("ThirdPersonMouseApplied"), 1);
+                    gui->SaveConsoleVariablesNextFrame();
+                }
+            }
+        }
+    });
+}
+
+static RegisterShipInitFunc sInit(RegisterOverlay, { CVAR_MINECRAFT_ENABLED });
+
+} // namespace
+
+bool HudOverlayActive() {
+    return sTextureValid && OverlayWanted() && sView != nullptr && Field(24) != 0;
+}
+
+} // namespace Minecraft
diff --git a/soh/soh/Enhancements/Minecraft/MinecraftSteve.cpp b/soh/soh/Enhancements/Minecraft/MinecraftSteve.cpp
new file mode 100644
index 0000000..a4d8efe
--- /dev/null
+++ b/soh/soh/Enhancements/Minecraft/MinecraftSteve.cpp
@@ -0,0 +1,388 @@
+#include "Minecraft.h"
+#include "Bridge.h"
+
+#include <cmath>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include <libultraship/libultraship.h>
+#include "soh/frame_interpolation.h"
+
+extern "C" {
+#include "z64.h"
+#include "macros.h"
+#include "functions.h"
+#include "variables.h"
+}
+
+// Steve in place of Link.
+//
+// Link's skeleton is re-proportioned to Minecraft's player model (8px head, 12px body, 12px arms and legs,
+// scaled to Minecraft's player height) by overriding each limb's joint offset, while Link's animations still
+// drive every rotation - so walking, sword swings, climbing, swimming and the ocarina all play on Steve. Each part
+// is a box textured with the player's real Minecraft skin (shared by the hidden Minecraft client, falling back to
+// a built-in Steve palette). Link's hands stay so the sword, shield and items he holds remain visible.
+
+namespace Minecraft {
+
+namespace {
+
+constexpr int kSkin = 64;
+
+alignas(8) uint8_t sSkin[kSkin * kSkin * 4];
+bool sSkinLoaded = false;
+uint32_t sSkinVersion = 0;
+int sSkinCheck = 0;
+
+struct LimbModel {
+    std::vector<Vtx> vtx;
+    std::vector<Gfx> gfx;
+    uint32_t skinVersion = ~0u;
+};
+LimbModel sModels[2][PLAYER_LIMB_MAX]; // [child?][limb]
+
+// ---------------------------------------------------------------------------------------------------------------
+// Skin
+
+void FillRect(int x0, int y0, int w, int h, uint8_t r, uint8_t g, uint8_t b) {
+    for (int y = y0; y < y0 + h; y++)
+        for (int x = x0; x < x0 + w; x++) {
+            uint8_t* p = &sSkin[(y * kSkin + x) * 4];
+            p[0] = r;
+            p[1] = g;
+            p[2] = b;
+            p[3] = 255;
+        }
+}
+
+// A plain Steve-coloured skin, used until Minecraft shares the real one
+void BuildFallbackSkin() {
+    memset(sSkin, 0, sizeof(sSkin));
+    FillRect(0, 0, 32, 16, 0xB7, 0x83, 0x6B);   // head: skin
+    FillRect(8, 0, 8, 8, 0x3A, 0x28, 0x1A);     // top of head: hair
+    FillRect(0, 8, 32, 2, 0x3A, 0x28, 0x1A);    // hair band around the head
+    FillRect(9, 12, 2, 1, 0xFF, 0xFF, 0xFF);    // eyes
+    FillRect(10, 12, 1, 1, 0x4A, 0x3C, 0xA0);
+    FillRect(13, 12, 2, 1, 0xFF, 0xFF, 0xFF);
+    FillRect(13, 12, 1, 1, 0x4A, 0x3C, 0xA0);
+    FillRect(11, 14, 2, 1, 0x6A, 0x40, 0x30);   // mouth
+    FillRect(16, 16, 24, 16, 0x00, 0xA8, 0xA8); // body: shirt
+    FillRect(40, 16, 16, 16, 0x00, 0xA8, 0xA8); // right arm: sleeve
+    FillRect(40, 26, 16, 6, 0xB7, 0x83, 0x6B);  // right forearm: skin
+    FillRect(32, 48, 16, 16, 0x00, 0xA8, 0xA8); // left arm
+    FillRect(32, 58, 16, 6, 0xB7, 0x83, 0x6B);
+    FillRect(0, 16, 16, 16, 0x3A, 0x38, 0xA0);  // right leg: trousers
+    FillRect(0, 29, 16, 3, 0x55, 0x55, 0x55);   // shoes
+    FillRect(16, 48, 16, 16, 0x3A, 0x38, 0xA0); // left leg
+    FillRect(16, 61, 16, 3, 0x55, 0x55, 0x55);
+}
+
+// %TEMP%/oot_mc_skin.bin: "SKIN" u32, version u32, width u32, height u32, then RGBA
+void RefreshSkin() {
+    if (!sSkinLoaded) {
+        BuildFallbackSkin();
+        sSkinLoaded = true;
+    }
+    if ((sSkinCheck++ % 60) != 0) {
+        return;
+    }
+    std::ifstream in(std::string(Bridge::TempDirPath()) + "oot_mc_skin.bin", std::ios::binary);
+    uint32_t header[4] = {};
+    if (!in.read((char*)header, sizeof(header)) || header[0] != 0x4E494B53 || header[2] != kSkin ||
+        header[3] != kSkin || header[1] == sSkinVersion) {
+        return;
+    }
+    std::vector<uint8_t> pixels(sizeof(sSkin));
+    if (in.read((char*)pixels.data(), pixels.size())) {
+        memcpy(sSkin, pixels.data(), sizeof(sSkin));
+        sSkinVersion = header[1];
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Model
+
+// Directions in a limb's local space for Steve's left (L), up (U) and front (F)
+struct Basis {
+    Vec3f l, u, f;
+};
+// Body and head limbs: bone (+X) points up, Link's left is +Z, front is +Y
+const Basis kUpright = { { 0, 0, 1 }, { 1, 0, 0 }, { 0, 1, 0 } };
+// Arms and legs hang down their bone: up is -X, so front flips to -Y
+const Basis kHanging = { { 0, 0, 1 }, { -1, 0, 0 }, { 0, -1, 0 } };
+
+struct BoxSpec {
+    f32 l0, l1, u0, u1, f0, f1; // pixels, in Steve's (left, up, front) space around the limb origin
+    int tu, tv;                 // skin texture origin of this part (Minecraft's cube UV layout)
+    int w, h, d;                // texture size of the whole part
+    int row0, rows;             // side-texture rows this piece uses (split arms/legs use 0..6 or 6..12)
+};
+
+Vec3f Map(const Basis& b, f32 l, f32 u, f32 f, f32 px) {
+    return { (b.l.x * l + b.u.x * u + b.f.x * f) * px, (b.l.y * l + b.u.y * u + b.f.y * f) * px,
+             (b.l.z * l + b.u.z * u + b.f.z * f) * px };
+}
+
+void AddQuad(std::vector<Vtx>& out, const Basis& b, f32 px, const f32 corners[4][3], const f32 uv[4][2],
+             Vec3f outward) {
+    Vec3f p[4];
+    for (int i = 0; i < 4; i++) {
+        p[i] = Map(b, corners[i][0], corners[i][1], corners[i][2], px);
+    }
+    // Wind counter-clockwise when seen from outside (N64 back-face culling)
+    Vec3f e1 = { p[1].x - p[0].x, p[1].y - p[0].y, p[1].z - p[0].z };
+    Vec3f e2 = { p[2].x - p[0].x, p[2].y - p[0].y, p[2].z - p[0].z };
+    Vec3f n = { e1.y * e2.z - e1.z * e2.y, e1.z * e2.x - e1.x * e2.z, e1.x * e2.y - e1.y * e2.x };
+    bool flip = n.x * outward.x + n.y * outward.y + n.z * outward.z < 0;
+    for (int k = 0; k < 4; k++) {
+        int i = flip ? 3 - k : k;
+        Vtx v{};
+        v.n.ob[0] = (s16)p[i].x;
+        v.n.ob[1] = (s16)p[i].y;
+        v.n.ob[2] = (s16)p[i].z;
+        v.n.tc[0] = (s16)(uv[i][0] * 32.0f);
+        v.n.tc[1] = (s16)(uv[i][1] * 32.0f);
+        v.n.n[0] = (s8)(outward.x * 120);
+        v.n.n[1] = (s8)(outward.y * 120);
+        v.n.n[2] = (s8)(outward.z * 120);
+        v.n.a = 255;
+        out.push_back(v);
+    }
+}
+
+void AddBox(std::vector<Vtx>& out, const Basis& b, f32 px, const BoxSpec& s) {
+    const f32 l0 = s.l0, l1 = s.l1, u0 = s.u0, u1 = s.u1, f0 = s.f0, f1 = s.f1;
+    const f32 tu = (f32)s.tu, tv = (f32)s.tv, w = (f32)s.w, d = (f32)s.d;
+    const f32 r0 = tv + d + s.row0, r1 = tv + d + s.row0 + s.rows;
+    Vec3f F = Map(b, 0, 0, 1, 1), L = Map(b, 1, 0, 0, 1), U = Map(b, 0, 1, 0, 1);
+    Vec3f nF = { -F.x, -F.y, -F.z }, nL = { -L.x, -L.y, -L.z }, nU = { -U.x, -U.y, -U.z };
+    { // front: Steve's right (l0) on the texture's left
+        f32 c[4][3] = { { l0, u1, f1 }, { l1, u1, f1 }, { l1, u0, f1 }, { l0, u0, f1 } };
+        f32 t[4][2] = { { tu + d, r0 }, { tu + d + w, r0 }, { tu + d + w, r1 }, { tu + d, r1 } };
+        AddQuad(out, b, px, c, t, F);
+    }
+    { // back
+        f32 c[4][3] = { { l1, u1, f0 }, { l0, u1, f0 }, { l0, u0, f0 }, { l1, u0, f0 } };
+        f32 t[4][2] = { { tu + 2 * d + w, r0 }, { tu + 2 * d + 2 * w, r0 }, { tu + 2 * d + 2 * w, r1 },
+                        { tu + 2 * d + w, r1 } };
+        AddQuad(out, b, px, c, t, nF);
+    }
+    { // Steve's right side (-L)
+        f32 c[4][3] = { { l0, u1, f0 }, { l0, u1, f1 }, { l0, u0, f1 }, { l0, u0, f0 } };
+        f32 t[4][2] = { { tu, r0 }, { tu + d, r0 }, { tu + d, r1 }, { tu, r1 } };
+        AddQuad(out, b, px, c, t, nL);
+    }
+    { // Steve's left side (+L)
+        f32 c[4][3] = { { l1, u1, f1 }, { l1, u1, f0 }, { l1, u0, f0 }, { l1, u0, f1 } };
+        f32 t[4][2] = { { tu + d + w, r0 }, { tu + 2 * d + w, r0 }, { tu + 2 * d + w, r1 }, { tu + d + w, r1 } };
+        AddQuad(out, b, px, c, t, L);
+    }
+    { // top
+        f32 c[4][3] = { { l0, u1, f0 }, { l1, u1, f0 }, { l1, u1, f1 }, { l0, u1, f1 } };
+        f32 t[4][2] = { { tu + d, tv }, { tu + d + w, tv }, { tu + d + w, tv + d }, { tu + d, tv + d } };
+        AddQuad(out, b, px, c, t, U);
+    }
+    { // bottom
+        f32 c[4][3] = { { l0, u0, f1 }, { l1, u0, f1 }, { l1, u0, f0 }, { l0, u0, f0 } };
+        f32 t[4][2] = { { tu + d + w, tv }, { tu + d + 2 * w, tv }, { tu + d + 2 * w, tv + d }, { tu + d + w, tv + d } };
+        AddQuad(out, b, px, c, t, nU);
+    }
+}
+
+// Pixel size in model units: Minecraft's player is 32px tall = 1.8 blocks = 54 OoT units (child: 0.72 scale)
+f32 PixelSize(bool child) {
+    return (child ? 0.72f : 1.0f) * 5400.0f / 32.0f;
+}
+
+bool PartFor(s32 limb, BoxSpec& s, const Basis*& basis) {
+    switch (limb) {
+        case PLAYER_LIMB_HEAD:
+            basis = &kUpright;
+            s = { -4, 4, 0, 8, -4, 4, 0, 0, 8, 8, 8, 0, 8 };
+            return true;
+        case PLAYER_LIMB_TORSO:
+            basis = &kUpright;
+            s = { -4, 4, 0, 12, -2, 2, 16, 16, 8, 12, 4, 0, 12 };
+            return true;
+        case PLAYER_LIMB_R_SHOULDER:
+            basis = &kHanging;
+            s = { -2, 2, -4, 2, -2, 2, 40, 16, 4, 12, 4, 0, 6 };
+            return true;
+        case PLAYER_LIMB_R_FOREARM:
+            basis = &kHanging;
+            s = { -2, 2, -6, 0, -2, 2, 40, 16, 4, 12, 4, 6, 6 };
+            return true;
+        case PLAYER_LIMB_L_SHOULDER:
+            basis = &kHanging;
+            s = { -2, 2, -4, 2, -2, 2, 32, 48, 4, 12, 4, 0, 6 };
+            return true;
+        case PLAYER_LIMB_L_FOREARM:
+            basis = &kHanging;
+            s = { -2, 2, -6, 0, -2, 2, 32, 48, 4, 12, 4, 6, 6 };
+            return true;
+        case PLAYER_LIMB_R_THIGH:
+            basis = &kHanging;
+            s = { -2, 2, -6, 0, -2, 2, 0, 16, 4, 12, 4, 0, 6 };
+            return true;
+        case PLAYER_LIMB_R_SHIN:
+            basis = &kHanging;
+            s = { -2, 2, -6, 0, -2, 2, 0, 16, 4, 12, 4, 6, 6 };
+            return true;
+        case PLAYER_LIMB_L_THIGH:
+            basis = &kHanging;
+            s = { -2, 2, -6, 0, -2, 2, 16, 48, 4, 12, 4, 0, 6 };
+            return true;
+        case PLAYER_LIMB_L_SHIN:
+            basis = &kHanging;
+            s = { -2, 2, -6, 0, -2, 2, 16, 48, 4, 12, 4, 6, 6 };
+            return true;
+        default:
+            return false;
+    }
+}
+
+void BuildLimb(LimbModel& m, s32 limb, bool child) {
+    m.vtx.clear();
+    m.gfx.clear();
+    m.skinVersion = sSkinVersion;
+    BoxSpec spec;
+    const Basis* basis = nullptr;
+    if (!PartFor(limb, spec, basis)) {
+        return;
+    }
+    AddBox(m.vtx, *basis, PixelSize(child), spec);
+
+    m.gfx.resize(48);
+    Gfx* g = m.gfx.data();
+    gDPPipeSync(g++);
+    gSPSetGeometryMode(g++, G_LIGHTING | G_SHADE | G_CULL_BACK | G_SHADING_SMOOTH);
+    gSPClearGeometryMode(g++, G_TEXTURE_GEN | G_TEXTURE_GEN_LINEAR);
+    gSPTexture(g++, 0xFFFF, 0xFFFF, 0, G_TX_RENDERTILE, G_ON);
+    gDPSetTextureFilter(g++, G_TF_POINT);
+    gDPSetCombineMode(g++, G_CC_MODULATEIDECALA, G_CC_PASS2);
+    gSPInvalidateTexCache(g++, (uintptr_t)sSkin);
+    gDPLoadTextureBlock(g++, (void*)sSkin, G_IM_FMT_RGBA, G_IM_SIZ_32b, kSkin, kSkin, 0, G_TX_NOMIRROR | G_TX_CLAMP,
+                        G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+    gSPVertex(g++, (uintptr_t)m.vtx.data(), (s32)m.vtx.size(), 0);
+    for (int q = 0; q < 6; q++) {
+        u8 o = (u8)(q * 4);
+        gSP2Triangles(g++, o, o + 1, o + 2, 0, o, o + 2, o + 3, 0);
+    }
+    gDPSetTextureFilter(g++, G_TF_BILERP);
+    gSPEndDisplayList(g++);
+    m.gfx.resize(g - m.gfx.data());
+}
+
+// Joint offsets (model units, in the parent limb's space) for Steve's proportions. Returns false to keep Link's.
+bool SteveJoint(s32 limb, f32 px, Vec3f* pos) {
+    switch (limb) {
+        case PLAYER_LIMB_WAIST:
+        case PLAYER_LIMB_LOWER:
+        case PLAYER_LIMB_UPPER:
+            *pos = { 0, 0, 0 };
+            return true;
+        case PLAYER_LIMB_R_THIGH:
+            *pos = { 0, 0, -2 * px };
+            return true;
+        case PLAYER_LIMB_L_THIGH:
+            *pos = { 0, 0, 2 * px };
+            return true;
+        case PLAYER_LIMB_R_SHIN:
+        case PLAYER_LIMB_L_SHIN:
+        case PLAYER_LIMB_R_FOOT:
+        case PLAYER_LIMB_L_FOOT:
+            *pos = { 6 * px, 0, 0 };
+            return true;
+        case PLAYER_LIMB_HEAD:
+            *pos = { 12 * px, 0, 0 };
+            return true;
+        case PLAYER_LIMB_L_SHOULDER:
+            *pos = { 10 * px, 0, 6 * px };
+            return true;
+        case PLAYER_LIMB_R_SHOULDER:
+            *pos = { 10 * px, 0, -6 * px };
+            return true;
+        case PLAYER_LIMB_L_FOREARM:
+        case PLAYER_LIMB_R_FOREARM:
+            *pos = { 4 * px, 0, 0 };
+            return true;
+        case PLAYER_LIMB_L_HAND:
+        case PLAYER_LIMB_R_HAND:
+            *pos = { 6 * px, 0, 0 };
+            return true;
+        case PLAYER_LIMB_SHEATH:
+            *pos = { 9 * px, -3 * px, 0 }; // across the back
+            return true;
+        default:
+            return false;
+    }
+}
+
+} // namespace
+
+} // namespace Minecraft
+
+extern "C" void Minecraft_OverridePlayerLimb(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot,
+                                             Player* player, s32 isPauseMenu, s32 emptyHand) {
+    using namespace Minecraft;
+    if (!Minecraft_IsEnabled() || dList == nullptr) {
+        return;
+    }
+
+    // In first person Minecraft draws the hand; Link's body must not block the camera
+    if (!isPauseMenu && FirstPersonActive()) {
+        *dList = nullptr;
+        return;
+    }
+    if (!CVarGetInteger(CVAR_MINECRAFT_STEVE, 1) || limbIndex <= 0 || limbIndex >= PLAYER_LIMB_MAX ||
+        player->skelAnime.skeleton == nullptr) {
+        return;
+    }
+
+    bool child = !LINK_IS_ADULT;
+    f32 px = PixelSize(child);
+
+    if (pos != nullptr) {
+        if (limbIndex == PLAYER_LIMB_ROOT) {
+            // Hips at Steve's leg height (12px), keeping the animation's bob, crouch and root motion
+            LodLimb* root = (LodLimb*)SEGMENTED_TO_VIRTUAL(player->skelAnime.skeleton[0]);
+            f32 restHip = root->jointPos.y > 0 ? (f32)root->jointPos.y : 3377.0f;
+            pos->y *= (12.0f * px) / restHip;
+        } else {
+            SteveJoint(limbIndex, px, pos);
+        }
+    }
+    if (rot != nullptr && limbIndex == PLAYER_LIMB_HEAD) {
+        // Link's head bone carries a built-in forward/down tilt that his face model hides; on Steve's square head it
+        // reads as staring at the ground. Keep the head turning left/right (rotation about its up axis) and sit it
+        // square on the shoulders otherwise.
+        rot->y = 0;
+        rot->z = 0;
+    }
+
+    switch (limbIndex) {
+        case PLAYER_LIMB_L_HAND:
+        case PLAYER_LIMB_R_HAND:
+            // Steve's arms end in a block, so Link's bare hands go; hands holding something keep the item
+            if (emptyHand) {
+                *dList = nullptr;
+            }
+            return;
+        case PLAYER_LIMB_SHEATH:
+            return; // the sword and shield on the back stay visible
+        default:
+            break;
+    }
+    if (*dList == nullptr) {
+        return;
+    }
+
+    RefreshSkin();
+    LimbModel& m = sModels[child ? 1 : 0][limbIndex];
+    if (m.skinVersion != sSkinVersion) {
+        BuildLimb(m, limbIndex, child);
+    }
+    *dList = m.gfx.empty() ? nullptr : m.gfx.data(); // waist, collar, cap and feet have no Steve part
+}
