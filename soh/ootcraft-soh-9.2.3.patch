+McChunkActor* SpawnActorFor(PlayState* play, Chunk* c) {
+    if (sChunkActorId < 0) {
+        return nullptr;
+    }
+    Actor* a = Actor_Spawn(&play->actorCtx, play, sChunkActorId, (f32)(c->key.x * CHUNK_BLOCKS * BLOCK_SIZE),
+                           (f32)(c->key.y * CHUNK_BLOCKS * BLOCK_SIZE + GridYOffset()),
+                           (f32)(c->key.z * CHUNK_BLOCKS * BLOCK_SIZE), 0,
+                           0, 0, 0);
+    if (a == nullptr) {
+        return nullptr;
+    }
+    McChunkActor* self = (McChunkActor*)a;
+    a->room = -1;
+    self->chunk = c;
+    c->actor = self;
+    c->colRegistered = false;
+    c->dirty = true;
+    return self;
