+void ApplySection(PlayState* play, int cx, int cy, int cz, const uint16_t* ids) {
+    ChunkKey key{ cx, cy, cz };
+    sKnownSections[CurrentSceneKey()].insert(key);
+    Chunk* c = FindChunk(key);
+    int nonAir = 0;
+    for (int i = 0; i < CHUNK_BLOCKS * CHUNK_BLOCKS * CHUNK_BLOCKS; i++) {
+        nonAir += ids[i] != 0;
+    }
+    if (c == nullptr) {
+        if (nonAir == 0) {
+            return;
+        }
+        c = new Chunk();
+        c->key = key;
+        SceneChunks()[key] = c;
+    }
+    for (int y = 0; y < CHUNK_BLOCKS; y++)
+        for (int z = 0; z < CHUNK_BLOCKS; z++)
+            for (int x = 0; x < CHUNK_BLOCKS; x++) {
+                c->blocks[x][y][z] = ids[(y * CHUNK_BLOCKS + z) * CHUNK_BLOCKS + x];
+            }
+    c->count = nonAir;
+    if (c->actor == nullptr && nonAir > 0 && play != nullptr) {
+        SpawnActorFor(play, c);
+    }
+    // neighbours may need faces revealed/hidden
+    c->dirty = true;
+    const int base[3] = { cx * CHUNK_BLOCKS, cy * CHUNK_BLOCKS, cz * CHUNK_BLOCKS };
+    for (int f = 0; f < 6; f++) {
+        Chunk* n = FindChunk({ cx + kFaceDir[f][0], cy + kFaceDir[f][1], cz + kFaceDir[f][2] });
+        if (n != nullptr) {
+            n->dirty = true;
+        }
+    }
+    (void)base;
+}
+
+void SpawnChunkActors(PlayState* play) {
+    sRegisteredVtx = 0;
+    for (auto& [key, c] : SceneChunks()) {
+        c->actor = nullptr;
+        c->colRegistered = false;
+        if (c->count > 0) {
+            SpawnActorFor(play, c);
+        }
+    }
+}
+
+int McBlockAt(int scene, int bx, int by, int bz) {
+    BlockPos p{ bx - SceneOriginBlocksX(scene), by - Bridge::ORIGIN_Y_BLOCKS, bz };
+    ChunkKey key = KeyFor(p);
+    auto known = sKnownSections.find(scene);
+    if (known == sKnownSections.end() || !known->second.count(key)) {
+        return -1;
+    }
+    auto chunks = sWorld.find(scene);
+    if (chunks == sWorld.end()) {
+        return 0;
+    }
+    auto it = chunks->second.find(key);
+    if (it == chunks->second.end()) {
+        return 0;
+    }
+    int lx, ly, lz;
+    LocalFor(p, lx, ly, lz);
+    return it->second->blocks[lx][ly][lz];
+}
